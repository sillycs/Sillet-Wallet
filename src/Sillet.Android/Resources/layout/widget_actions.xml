<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:padding="10dp" android:background="@drawable/widget_bg">
    <LinearLayout android:id="@+id/w_send" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
        <ImageView android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/widget_chip" android:padding="10dp" android:src="@drawable/ic_w_send" android:contentDescription="Send" />
        <TextView android:id="@+id/w_send_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="#FFFFFFFF" android:textSize="12sp" android:maxLines="1" android:text="Send" />
    </LinearLayout>
    <LinearLayout android:id="@+id/w_receive" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
        <ImageView android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/widget_chip" android:padding="10dp" android:src="@drawable/ic_w_receive" android:contentDescription="Receive" />
        <TextView android:id="@+id/w_receive_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="#FFFFFFFF" android:textSize="12sp" android:maxLines="1" android:text="Receive" />
    </LinearLayout>
    <LinearLayout android:id="@+id/w_market" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
        <ImageView android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/widget_chip" android:padding="10dp" android:src="@drawable/ic_w_market" android:contentDescription="Market" />
        <TextView android:id="@+id/w_market_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="#FFFFFFFF" android:textSize="12sp" android:maxLines="1" android:text="Market" />
    </LinearLayout>
    <LinearLayout android:id="@+id/w_activity" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
        <ImageView android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/widget_chip" android:padding="10dp" android:src="@drawable/ic_w_activity" android:contentDescription="Activity" />
        <TextView android:id="@+id/w_activity_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="#FFFFFFFF" android:textSize="12sp" android:maxLines="1" android:text="Activity" />
    </LinearLayout>
</LinearLayout>
