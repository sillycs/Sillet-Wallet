<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-android</TargetFramework>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>Sillet.Droid</RootNamespace>
    <AssemblyName>Sillet.Android</AssemblyName>
    <ApplicationId>fun.raton.sillet</ApplicationId>
    <ApplicationTitle>Sillet</ApplicationTitle>
    <ApplicationVersion>9</ApplicationVersion>
    <ApplicationDisplayVersion>1.1.7</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <RunAOTCompilation>true</RunAOTCompilation>
    <AndroidEnableProfiledAot>true</AndroidEnableProfiledAot>
    <AndroidStripILAfterAOT>true</AndroidStripILAfterAOT>
    <AndroidUseAssemblyStore>true</AndroidUseAssemblyStore>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <DebuggerSupport>false</DebuggerSupport>
    <EventSourceSupport>false</EventSourceSupport>
    <RuntimeIdentifiers>android-arm64;android-arm</RuntimeIdentifiers>
    <AndroidLinkMode>SdkOnly</AndroidLinkMode>
    <AndroidEnableSGenConcurrent>true</AndroidEnableSGenConcurrent>
    <NoWarn>$(NoWarn);CS0618;CA1422;CA1416;XAOBS001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <AndroidEnvironment Include="environment.txt" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Android" Version="11.2.3" />
    <PackageReference Include="ZXing.Net" Version="0.16.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sillet.Mobile\Sillet.Mobile.csproj" />
  </ItemGroup>

</Project>
