<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>7.3</LangVersion>
    <RootNamespace>Sillet.App</RootNamespace>
    <AssemblyName>Sillet</AssemblyName>
    <Product>Sillet</Product>
    <ApplicationIcon>Assets\silleticon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Security" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="ZXing.Net" Version="0.16.9" />
    <PackageReference Include="Fody" Version="6.8.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Costura.Fody" Version="5.7.0">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\*.png" />
    <None Remove="Assets\moizefala.png" />
    <None Remove="Assets\silleticon.png" />
    <None Remove="Assets\silleticonblack.png" />
    <None Remove="Assets\silly.png" />
    <Resource Include="Assets\silleticon.ico" />
    <EmbeddedResource Include="Assets\sounds\*.mp3" LogicalName="Sillet.sound.%(Filename)" />
    <Resource Include="Assets\Fonts\*.otf" />
    <Resource Include="Assets\Fonts\OFL.txt" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Sillet.Core/Sillet.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Properties\Resources.Designer.cs" />
    <EmbeddedResource Remove="Properties\Resources.resx" />
    <None Remove="Properties\Resources.resx" />
  </ItemGroup>

</Project>
