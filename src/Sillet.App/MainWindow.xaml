<Window x:Class="Sillet.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Sillet.App.ViewModels"
        xmlns:views="clr-namespace:Sillet.App.Views"
        xmlns:c="clr-namespace:Sillet.App.Controls"
        Title="Sillet" Icon="Assets/silleticon.ico" Width="1280" Height="800" MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="14"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:OnboardingViewModel}"><views:OnboardingView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:UnlockViewModel}"><views:UnlockView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:WatchWalletViewModel}"><views:WatchWalletView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:HomeViewModel}"><views:HomeView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:MarketViewModel}"><views:MarketView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SendViewModel}"><views:SendView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReceiveViewModel}"><views:ReceiveView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ActivityViewModel}"><views:ActivityView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:TradeViewModel}"><views:TradeView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:DonateViewModel}"><views:DonateView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView /></DataTemplate>

        <Storyboard x:Key="PageIn">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3" />
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="14" To="0" Duration="0:0:0.38">
                <DoubleAnimation.EasingFunction>
                    <QuinticEase EasingMode="EaseOut" />
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="38" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <Border Grid.RowSpan="2" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,1,0" ClipToBounds="True"
                Visibility="{Binding IsUnlocked, Converter={StaticResource BoolToVis}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Width" Value="216" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsNavCollapsed}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Width" To="72" Duration="0:0:0.22" EasingFunction="{StaticResource EaseOut}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Width" To="216" Duration="0:0:0.22" EasingFunction="{StaticResource EaseOut}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel Margin="14,10,14,16">
                <Button DockPanel.Dock="Top" Content="&#xE700;" Width="36" Height="34" FontSize="15"
                        Command="{Binding ToggleNavCommand}" ToolTip="{c:Tr 'Collapse or expand the menu (Ctrl+B)'}"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Button.Icon}">
                            <Setter Property="HorizontalAlignment" Value="Left" />
                            <Setter Property="Margin" Value="4,0,0,14" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsNavCollapsed}" Value="True">
                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                    <Setter Property="Margin" Value="0,0,0,14" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,18">
                    <Grid Width="28" Height="28" VerticalAlignment="Center" Visibility="{Binding IsNavCollapsed, Converter={StaticResource BoolToVis}}">
                        <Image Source="{Binding LogoName, Converter={StaticResource ResourceImage}}" RenderOptions.BitmapScalingMode="HighQuality" Stretch="Uniform" />
                    </Grid>
                    <TextBlock Text="{c:Tr 'Sillet Wallet'}" Style="{StaticResource Text.Wordmark}" FontSize="21" FontWeight="Bold" Margin="2,0,0,2" VerticalAlignment="Center"
                               Visibility="{Binding IsNavExpanded, Converter={StaticResource BoolToVis}}" />

                </StackPanel>

                <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
                    <Button x:Name="ProfileButton" Command="{Binding ToggleProfilesCommand}" HorizontalContentAlignment="Stretch" FontWeight="Normal"
                            ToolTip="{Binding ActiveProfileName}"
                            IsHitTestVisible="{Binding IsOpen, ElementName=ProfilePopup, Converter={StaticResource InvertBool}}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
                                <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                <Setter Property="Padding" Value="8,7" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsNavCollapsed}" Value="True">
                                        <Setter Property="Padding" Value="0,7" />
                                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="32" Height="30">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Margin" Value="0" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsNavCollapsed}" Value="True">
                                                <Setter Property="Margin" Value="7,0,0,0" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid Width="26" Height="26" HorizontalAlignment="Left" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding ActiveProfileInitial}" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Border CornerRadius="13" Visibility="{Binding ActiveProfileHasPhoto, Converter={StaticResource BoolToVis}}">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding ActiveProfilePhoto}" Stretch="UniformToFill" />
                                        </Border.Background>
                                    </Border>
                                </Grid>
                                <Border Width="16" Height="16" CornerRadius="8" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                        Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BgBrush}" BorderThickness="2">
                                    <Image Width="9" Height="9" Source="{Binding WalletIconName, Converter={StaticResource ResourceImage}}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                            <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center" Visibility="{Binding IsNavExpanded, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding ActiveProfileName}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{c:Tr 'Hardware wallet'}" FontSize="10.5" Foreground="{DynamicResource TextTertiaryBrush}"
                                           Visibility="{Binding IsWatchOnly, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="9" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextTertiaryBrush}" Visibility="{Binding IsNavExpanded, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </Button>
                    <Popup x:Name="ProfilePopup" IsOpen="{Binding IsProfilesOpen, Mode=TwoWay}" PlacementTarget="{Binding ElementName=ProfileButton}" Placement="Bottom"
                           VerticalOffset="6" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                        <Border Width="260" Margin="0,0,16,16" c:Anim.Enter="True" c:Anim.Offset="-6" c:Anim.ScaleFrom="0.97" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderStrongBrush}"
                                BorderThickness="1" CornerRadius="0" Padding="6">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.45" Color="Black" />
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="{c:Tr 'Your wallets'}" Style="{StaticResource Text.Label}" FontSize="11.5" Margin="10,6,0,6" />
                                <ItemsControl ItemsSource="{Binding ProfileList}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.SwitchProfileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" Style="{StaticResource Button.Ghost}" HorizontalContentAlignment="Stretch"
                                                    Padding="10,8" FontWeight="Normal" Foreground="{DynamicResource TextBrush}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="26" Height="26" CornerRadius="8" Background="{DynamicResource SurfacePressedBrush}">
                                                        <Grid>
                                                            <TextBlock Text="{Binding Initial}" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            <Border CornerRadius="8" Visibility="{Binding HasPhoto, Converter={StaticResource BoolToVis}}">
                                                                <Border.Background>
                                                                    <ImageBrush ImageSource="{Binding PhotoPath}" Stretch="UniformToFill" />
                                                                </Border.Background>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                        <TextBlock Text="{Binding Name}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding KindText}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Border Style="{StaticResource Divider}" Margin="6,6" />
                                <Button Style="{StaticResource Button.Ghost}" Command="{Binding AddWalletCommand}" HorizontalContentAlignment="Left" Padding="10,8" FontWeight="Normal">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock Text="{c:Tr 'Create or import a wallet'}" Margin="10,0,0,0" FontSize="12.5" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource Button.Ghost}" Command="{Binding AddWatchWalletCommand}" HorizontalContentAlignment="Left" Padding="10,8" FontWeight="Normal">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xEA18;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock Text="{c:Tr 'Add a hardware wallet'}" Margin="10,0,0,0" FontSize="12.5" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,2">
                    <Button Command="{Binding DonateCommand}" HorizontalAlignment="Stretch" FontWeight="Normal"
                            Margin="0,0,0,2" ToolTip="{c:Tr 'Support Sillet'}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
                                <Setter Property="HorizontalContentAlignment" Value="Left" />
                                <Setter Property="Padding" Value="12,9" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsNavCollapsed}" Value="True">
                                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                                        <Setter Property="Padding" Value="0,9" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsDonatePage}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xEB52;" Style="{StaticResource Text.Icon}" FontSize="14" Foreground="{DynamicResource NegativeBrush}" />
                            <TextBlock Text="{c:Tr 'Donate'}" Margin="12,0,0,0" Visibility="{Binding IsNavExpanded, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding LockCommand}"
                            HorizontalAlignment="Stretch" FontWeight="Normal" ToolTip="{c:Tr 'Lock'}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
                                <Setter Property="HorizontalContentAlignment" Value="Left" />
                                <Setter Property="Padding" Value="12,9" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsNavCollapsed}" Value="True">
                                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                                        <Setter Property="Padding" Value="0,9" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72E;" Style="{StaticResource Text.Icon}" FontSize="14"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <TextBlock Text="{c:Tr 'Lock'}" Margin="12,0,0,0" Visibility="{Binding IsNavExpanded, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Button>
                    <Border Style="{StaticResource Divider}" Margin="12,14,12,12" Visibility="{Binding IsNavExpanded, Converter={StaticResource BoolToVis}}" />
                    <StackPanel Margin="12,0,0,0" Visibility="{Binding IsNavExpanded, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{c:Tr 'Made by the Raton team'}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" />
                        <Button Style="{StaticResource Button.Link}" Content="raton.fun/wallet" FontSize="11" HorizontalAlignment="Left"
                                Margin="0,2,0,0" Command="{Binding OpenRatonCommand}" />
                    </StackPanel>
                </StackPanel>

                <ListBox ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedNav, Mode=TwoWay}"
                         Style="{StaticResource List.Plain}" ItemContainerStyle="{StaticResource NavItem}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Background="Transparent" ToolTip="{Binding Title}"
                                        ToolTipService.IsEnabled="{Binding DataContext.IsNavCollapsed, RelativeSource={RelativeSource AncestorType=Window}}">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="HorizontalAlignment" Value="Left" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.IsNavCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                <Setter Property="HorizontalAlignment" Value="Center" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="{Binding Glyph}" Style="{StaticResource Text.Icon}" FontSize="15"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                <TextBlock Text="{Binding Title}" Margin="13,0,0,0" FontSize="13.5"
                                           Visibility="{Binding DataContext.IsNavExpanded, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <ContentControl x:Name="PageHost" Grid.Row="1" Grid.Column="1" Margin="40,6,40,30" Focusable="False"
                        Content="{Binding CurrentPage, NotifyOnTargetUpdated=True}"
                        Visibility="{Binding IsUnlocked, Converter={StaticResource BoolToVis}}">
            <ContentControl.RenderTransform>
                <TranslateTransform />
            </ContentControl.RenderTransform>
            <ContentControl.Triggers>
                <EventTrigger RoutedEvent="Binding.TargetUpdated">
                    <BeginStoryboard Storyboard="{StaticResource PageIn}" />
                </EventTrigger>
            </ContentControl.Triggers>
        </ContentControl>

        <Grid Grid.Row="1" Grid.ColumnSpan="2" Visibility="{Binding IsUnlocked, Converter={StaticResource BoolToVisInverse}}">
            <ContentControl Focusable="False" Content="{Binding AuthPage, NotifyOnTargetUpdated=True}">
                <ContentControl.RenderTransform>
                    <TranslateTransform />
                </ContentControl.RenderTransform>
                <ContentControl.Triggers>
                    <EventTrigger RoutedEvent="Binding.TargetUpdated">
                        <BeginStoryboard Storyboard="{StaticResource PageIn}" />
                    </EventTrigger>
                </ContentControl.Triggers>
            </ContentControl>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,22">
                <TextBlock Text="{c:Tr 'Made by the Raton team  ·  '}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" />
                <Button Style="{StaticResource Button.Link}" Content="raton.fun" FontSize="11" Command="{Binding OpenRatonCommand}" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
            <Grid Visibility="{Binding IsUnlocked, Converter={StaticResource BoolToVis}}">
                <Button x:Name="SupportButton" Command="{Binding ToggleSupportCommand}" ToolTip="{c:Tr 'Support'}" WindowChrome.IsHitTestVisibleInChrome="True"
                        IsHitTestVisible="{Binding IsOpen, ElementName=SupportPopup, Converter={StaticResource InvertBool}}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Button.Chrome}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSupportOpen}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Path Width="15" Height="15" Stretch="Uniform" StrokeThickness="1.1" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          Data="M3,12 A9,9 0 1 0 21,12 A9,9 0 1 0 3,12 Z M8,12 A4,4 0 1 0 16,12 A4,4 0 1 0 8,12 Z M5.6,5.6 L9.2,9.2 M14.8,14.8 L18.4,18.4 M18.4,5.6 L14.8,9.2 M9.2,14.8 L5.6,18.4" />
                </Button>
                <Popup x:Name="SupportPopup" IsOpen="{Binding IsSupportOpen, Mode=TwoWay}" PlacementTarget="{Binding ElementName=SupportButton}" Placement="Bottom"
                       HorizontalOffset="-290" VerticalOffset="6" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                    <Border Width="320" Margin="0,0,16,16" c:Anim.Enter="True" c:Anim.Offset="-6" c:Anim.ScaleFrom="0.97" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderStrongBrush}"
                            BorderThickness="1" CornerRadius="0" Padding="6">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.45" Color="Black" />
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="{c:Tr 'Support'}" Style="{StaticResource Text.Label}" FontSize="11.5" Margin="10,6,0,6" />
                            <Button Command="{Binding SupportTelegramCommand}" Style="{StaticResource Button.Ghost}" HorizontalContentAlignment="Left" Padding="10,9" FontWeight="Normal"
                                    Foreground="{DynamicResource TextBrush}">
                                <StackPanel Orientation="Horizontal">
                                    <Image Width="20" Height="20" Source="{Binding TelegramIconName, Converter={StaticResource ResourceImage}}" />
                                    <TextBlock Text="{c:Tr 'Contact the developer on Telegram'}" Margin="12,0,0,0" FontSize="12.5" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding SupportDiscordCommand}" Style="{StaticResource Button.Ghost}" HorizontalContentAlignment="Left" Padding="10,9" FontWeight="Normal"
                                    Foreground="{DynamicResource TextBrush}">
                                <StackPanel Orientation="Horizontal">
                                    <Image Width="20" Height="20" Source="{Binding DiscordIconName, Converter={StaticResource ResourceImage}}" />
                                    <TextBlock Text="{c:Tr 'Ask our community or staff'}" Margin="12,0,0,0" FontSize="12.5" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
            <Grid Visibility="{Binding IsUnlocked, Converter={StaticResource BoolToVis}}">
                <Button x:Name="BellButton" Command="{Binding ToggleNotificationsCommand}" ToolTip="{c:Tr 'Notifications'}" WindowChrome.IsHitTestVisibleInChrome="True"
                        IsHitTestVisible="{Binding IsOpen, ElementName=BellPopup, Converter={StaticResource InvertBool}}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Button.Chrome}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsNotificationsOpen}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Grid Width="18" Height="18">
                        <TextBlock Text="&#xEA8F;" FontFamily="{StaticResource IconFont}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   RenderTransformOrigin="0.5,0.1">
                            <TextBlock.RenderTransform>
                                <RotateTransform />
                            </TextBlock.RenderTransform>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasUnread}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)">
                                                            <EasingDoubleKeyFrame KeyTime="0:0:0.08" Value="16" />
                                                            <EasingDoubleKeyFrame KeyTime="0:0:0.18" Value="-14" />
                                                            <EasingDoubleKeyFrame KeyTime="0:0:0.28" Value="10" />
                                                            <EasingDoubleKeyFrame KeyTime="0:0:0.38" Value="-6" />
                                                            <EasingDoubleKeyFrame KeyTime="0:0:0.48" Value="3" />
                                                            <EasingDoubleKeyFrame KeyTime="0:0:0.6" Value="0" />
                                                        </DoubleAnimationUsingKeyFrames>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Ellipse Width="8" Height="8" Fill="{DynamicResource NegativeBrush}" Stroke="{DynamicResource BgBrush}" StrokeThickness="1.5"
                                 HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-1,0" RenderTransformOrigin="0.5,0.5"
                                 Visibility="{Binding HasUnread, Converter={StaticResource BoolToVis}}">
                            <Ellipse.RenderTransform>
                                <ScaleTransform />
                            </Ellipse.RenderTransform>
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0" To="1" Duration="0:0:0.35">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase EasingMode="EaseOut" Amplitude="0.6" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0" To="1" Duration="0:0:0.35">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase EasingMode="EaseOut" Amplitude="0.6" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>
                    </Grid>
                </Button>
                <Popup x:Name="BellPopup" IsOpen="{Binding IsNotificationsOpen, Mode=TwoWay}" PlacementTarget="{Binding ElementName=BellButton}" Placement="Bottom"
                       HorizontalOffset="-326" VerticalOffset="6" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                    <Border Width="360" Margin="12,0,12,16" CornerRadius="0" c:Anim.Enter="True" c:Anim.Offset="-6" c:Anim.ScaleFrom="0.97" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderStrongBrush}"
                            BorderThickness="1" Padding="0,14,0,8">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.45" Color="Black" />
                        </Border.Effect>
                        <StackPanel>
                            <Grid Margin="18,0,14,10">
                                <TextBlock Text="{c:Tr 'Notifications'}" Style="{StaticResource Text.Subtitle}" VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Visibility="{Binding HasNotifications, Converter={StaticResource BoolToVis}}">
                                    <Button Style="{StaticResource Button.Link}" Content="{c:Tr 'Mark all read'}" FontSize="12" Command="{Binding MarkAllReadCommand}" />
                                    <Button Style="{StaticResource Button.Link}" Content="{c:Tr 'Clear'}" FontSize="12" Margin="14,0,0,0" Command="{Binding ClearNotificationsCommand}" />
                                </StackPanel>
                            </Grid>
                            <Border Style="{StaticResource Divider}" />
                            <StackPanel Margin="0,34,0,30" HorizontalAlignment="Center" Visibility="{Binding HasNotifications, Converter={StaticResource BoolToVisInverse}}">
                                <TextBlock Text="&#xEA8F;" FontFamily="{StaticResource IconFont}" FontSize="22" HorizontalAlignment="Center" Foreground="{DynamicResource TextTertiaryBrush}" />
                                <TextBlock Text="{c:Tr 'You\'re all caught up'}" Style="{StaticResource Text.Caption}" Margin="0,10,0,0" HorizontalAlignment="Center" />
                                <TextBlock Text="{c:Tr 'Payments, news and price moves show up here'}" Style="{StaticResource Text.Label}" FontSize="11.5" Margin="0,4,0,0"
                                           HorizontalAlignment="Center" Foreground="{DynamicResource TextTertiaryBrush}" />
                            </StackPanel>
                            <ScrollViewer MaxHeight="430" VerticalScrollBarVisibility="Auto" Focusable="False"
                                          Visibility="{Binding HasNotifications, Converter={StaticResource BoolToVis}}">
                                <ItemsControl ItemsSource="{Binding NotificationList}" Focusable="False" Margin="6,6,6,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.OpenNotificationCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" Cursor="Hand" FocusVisualStyle="{x:Null}" Foreground="{DynamicResource TextBrush}"
                                                    HorizontalContentAlignment="Stretch">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Bd" Background="Transparent" CornerRadius="10" Padding="12,10">
                                                            <ContentPresenter />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="32" Height="32" CornerRadius="10" VerticalAlignment="Top">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{DynamicResource SurfacePressedBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Tone}" Value="positive">
                                                                        <Setter Property="Background" Value="{DynamicResource PositiveSoftBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Tone}" Value="negative">
                                                                        <Setter Property="Background" Value="{DynamicResource NegativeSoftBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Tone}" Value="warning">
                                                                        <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Tone}" Value="positive">
                                                                            <Setter Property="Foreground" Value="{DynamicResource PositiveBrush}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Tone}" Value="negative">
                                                                            <Setter Property="Foreground" Value="{DynamicResource NegativeBrush}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Tone}" Value="warning">
                                                                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="12,0,8,0">
                                                        <TextBlock Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="FontWeight" Value="Normal" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsNew}" Value="True">
                                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Label}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"
                                                                   MaxHeight="34" TextTrimming="CharacterEllipsis" Visibility="{Binding HasMessage, Converter={StaticResource BoolToVis}}" />
                                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                            <TextBlock Text="{Binding TimeText}" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextTertiaryBrush}" />
                                                            <Border CornerRadius="6" Padding="7,1" Margin="10,0,0,0" Background="{DynamicResource SurfacePressedBrush}"
                                                                    Visibility="{Binding HasAction, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Text="{Binding ActionText}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                            </Border>
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Top">
                                                        <Ellipse Width="7" Height="7" Fill="{DynamicResource NegativeBrush}" HorizontalAlignment="Right" Margin="0,6,4,0"
                                                                 Visibility="{Binding IsNew, Converter={StaticResource BoolToVis}}" />
                                                        <Button Style="{StaticResource Button.Icon}" Content="&#xE711;" Width="24" Height="24" FontSize="10" Margin="0,4,0,0" ToolTip="{c:Tr 'Dismiss'}"
                                                                Command="{Binding DataContext.DismissNotificationCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
            <Button Style="{StaticResource Button.Chrome}" Content="&#xE921;" Click="Minimize_Click"
                    WindowChrome.IsHitTestVisibleInChrome="True" />
            <Button x:Name="MaximizeButton" Style="{StaticResource Button.Chrome}" Content="&#xE922;" Click="Maximize_Click"
                    WindowChrome.IsHitTestVisibleInChrome="True" />
            <Button Style="{StaticResource Button.ChromeClose}" Content="&#xE8BB;" Click="Close_Click"
                    WindowChrome.IsHitTestVisibleInChrome="True" />
        </StackPanel>

        <Border Grid.RowSpan="2" Grid.ColumnSpan="2" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,30"
                CornerRadius="10" Padding="16,10" Background="{DynamicResource ToastBrush}" MaxWidth="560"
                c:Anim.Enter="True" c:Anim.Offset="18"
                Visibility="{Binding IsToastVisible, Converter={StaticResource BoolToVis}}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity="0.5" Color="Black" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,10,0">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="{DynamicResource PositiveBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ToastIsError}" Value="True">
                                    <Setter Property="Fill" Value="{DynamicResource NegativeBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <TextBlock Text="{Binding ToastMessage}" Foreground="{DynamicResource OnToastBrush}" TextWrapping="Wrap" FontSize="13"
                           MaxWidth="460" VerticalAlignment="Center" />
                <Button Style="{StaticResource Button.Link}" Content="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="9"
                        Foreground="{DynamicResource TextTertiaryBrush}" Margin="14,0,0,0" VerticalAlignment="Center"
                        Command="{Binding DismissToastCommand}" />
            </StackPanel>
        </Border>

        <Grid Grid.RowSpan="2" Grid.ColumnSpan="2" Visibility="{Binding IsDialogOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="#B3000000" c:Anim.Enter="True" c:Anim.Offset="0" />
            <Border Style="{StaticResource Card}" Width="400" Padding="26,24" HorizontalAlignment="Center" VerticalAlignment="Center"
                    c:Anim.Enter="True" c:Anim.ScaleFrom="0.96" c:Anim.Offset="6">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="50" ShadowDepth="10" Opacity="0.6" Color="Black" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="{Binding DialogTitle}" Style="{StaticResource Text.Subtitle}" FontSize="16" />
                    <TextBlock Text="{Binding DialogMessage}" Style="{StaticResource Text.Caption}" FontSize="13" Margin="0,8,0,0" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                        <Button Style="{StaticResource Button.Secondary}" Content="{c:Tr 'Cancel'}" Command="{Binding DialogCancelCommand}" />
                        <Button Style="{StaticResource Button.Primary}" Content="{Binding DialogConfirmText}" Command="{Binding DialogConfirmCommand}"
                                Margin="8,0,0,0" Visibility="{Binding DialogIsDanger, Converter={StaticResource BoolToVisInverse}}" />
                        <Button Style="{StaticResource Button.Danger}" Content="{Binding DialogConfirmText}" Command="{Binding DialogConfirmCommand}"
                                Margin="8,0,0,0" Visibility="{Binding DialogIsDanger, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Image x:Name="ThemeFade" Grid.RowSpan="2" Grid.ColumnSpan="2" Panel.ZIndex="1000" Stretch="Fill"
               IsHitTestVisible="False" Visibility="Collapsed" />
        <Grid x:Name="Splash" Grid.RowSpan="2" Grid.ColumnSpan="2" Panel.ZIndex="1001" Background="{DynamicResource BgBrush}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Image Source="{Binding LogoName, Converter={StaticResource ResourceImage}}" Width="72" Height="72" RenderOptions.BitmapScalingMode="HighQuality" />
                <ProgressBar IsIndeterminate="True" Width="64" Height="3" Margin="0,22,0,0" BorderThickness="0"
                             Background="{DynamicResource SurfaceAltBrush}" Foreground="{DynamicResource TextBrush}" />
            </StackPanel>
            <TextBlock x:Name="SplashStatus" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,34" FontSize="12"
                       Foreground="{DynamicResource TextTertiaryBrush}" />
        </Grid>
    </Grid>
</Window>
