<UserControl x:Class="Sillet.App.Views.ActivityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Sillet.App.Controls">
    <Grid Margin="0,10,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource Card}" Padding="12,18,12,10" c:Anim.Enter="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="10,0,10,10">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{c:Tr 'Activity'}" Style="{StaticResource Text.Subtitle}" />
                        <Border Style="{StaticResource Chip.Static}" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center"
                                Visibility="{Binding HasAssetFilter, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding AssetFilterText}" FontSize="12" VerticalAlignment="Center" />
                                <Button Style="{StaticResource Button.Icon}" Content="&#xE711;" FontSize="10" Width="22" Height="22" Margin="6,0,-4,0"
                                        Command="{Binding ClearAssetFilterCommand}" ToolTip="{c:Tr 'Show all'}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <Border Style="{StaticResource SegmentHost}" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisInverse}}">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Style="{StaticResource Segment}" GroupName="ActivityFilter" Content="{c:Tr 'All'}" IsChecked="{Binding FilterAll, Mode=TwoWay}" />
                            <RadioButton Style="{StaticResource Segment}" GroupName="ActivityFilter" Content="{c:Tr 'Sent'}" IsChecked="{Binding FilterSent, Mode=TwoWay}" />
                            <RadioButton Style="{StaticResource Segment}" GroupName="ActivityFilter" Content="{c:Tr 'Received'}" IsChecked="{Binding FilterReceived, Mode=TwoWay}" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding CountText}" Style="{StaticResource Text.Label}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"
                               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisInverse}}" />
                </Grid>

                <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,40"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                    <Border Width="52" Height="52" CornerRadius="26" Background="{DynamicResource SurfaceAltBrush}" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE81C;" FontFamily="{StaticResource IconFont}" FontSize="19" Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{c:Tr 'No transfers yet'}" Style="{StaticResource Text.Subtitle}" HorizontalAlignment="Center" Margin="0,14,0,0" />
                    <TextBlock Text="{c:Tr 'Transfers you send or receive show up here'}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>

                <TextBlock Grid.Row="1" Text="{c:Tr 'Nothing matches this filter'}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0"
                           Visibility="{Binding ShowNoMatches, Converter={StaticResource BoolToVis}}" />

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False"
                              Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisInverse}}">
                    <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ContentControl Style="{StaticResource HoverRow}" c:Anim.Stagger="True" c:Anim.Enter="True" c:Anim.Offset="6" Cursor="Hand" MouseLeftButtonUp="Row_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="36" Height="36">
                                            <c:CoinIcon Source="{Binding IconPath}" Initial="{Binding Initial}" Size="34" />
                                            <Border Width="16" Height="16" CornerRadius="8" Background="{DynamicResource SurfaceBrush}"
                                                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-3,-3">
                                                <TextBlock Text="{Binding DirectionGlyph}" FontFamily="{StaticResource IconFont}" FontSize="8"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsIncoming}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource PositiveBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </Grid>
                                        <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Title}" FontSize="13.5" />
                                                <Border Style="{StaticResource Chip.Static}" Padding="6,0" Margin="8,0,0,0">
                                                    <TextBlock Text="{Binding Network}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Style="{StaticResource Text.Label}" FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding DateText, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding ToText, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding AmountText}" FontSize="13.5" HorizontalAlignment="Right">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsIncoming}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource PositiveBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding FeeText}" Style="{StaticResource Text.Label}" FontSize="12" HorizontalAlignment="Right" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <Button Style="{StaticResource Button.Icon}" Content="&#xE8C8;" Width="30" Height="30" FontSize="12" ToolTip="{c:Tr 'Copy transaction id'}"
                                                    Command="{Binding DataContext.CopyTxCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Style="{StaticResource Button.Icon}" Content="&#xE8A7;" Width="30" Height="30" FontSize="12" ToolTip="{c:Tr 'Open in explorer'}"
                                                    Command="{Binding DataContext.OpenTxCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Grid>
                                </ContentControl>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border Style="{StaticResource Card}" c:Anim.Enter="True" c:Anim.Delay="80">
                <StackPanel>
                    <TextBlock Text="{c:Tr 'Full history'}" Style="{StaticResource Text.Subtitle}" />
                    <TextBlock Text="{c:Tr 'Everything you sent and received, straight from the network explorer'}" Style="{StaticResource Text.Caption}"
                               Margin="0,6,0,16" />
                    <TextBlock Text="{c:Tr 'Network'}" Style="{StaticResource Text.Label}" Margin="0,0,0,8" />
                    <ComboBox ItemsSource="{Binding Chains}" SelectedItem="{Binding SelectedChain, Mode=TwoWay}" Style="{StaticResource Select}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Grid Margin="0,12,0,0">
                        <Border Style="{StaticResource Card.Soft}" Padding="12,10,40,10">
                            <TextBlock Text="{Binding SelectedAddress}" FontFamily="{StaticResource MonoFont}" FontSize="12" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextSecondaryBrush}" ToolTip="{Binding SelectedAddress}" />
                        </Border>
                        <Button Style="{StaticResource Button.Icon}" Content="&#xE8C8;" Width="28" Height="28" FontSize="12" HorizontalAlignment="Right"
                                Margin="0,0,5,0" Command="{Binding CopyAddressCommand}" ToolTip="{c:Tr 'Copy address'}" />
                    </Grid>
                    <Button Style="{StaticResource Button.Primary}" Command="{Binding OpenExplorerCommand}" Margin="0,12,0,0" Padding="16,10"
                            HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{c:Tr 'Open in explorer'}" />
                            <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource IconFont}" FontSize="11" Margin="8,1,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,14,0,0" c:Anim.Enter="True" c:Anim.Delay="140">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{c:Tr 'Summary'}" Style="{StaticResource Text.Subtitle}" />
                    <UniformGrid Grid.Row="1" Columns="4" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="{Binding TransfersText}" Style="{StaticResource Text.Title}" FontSize="20" />
                            <TextBlock Text="{c:Tr 'Transfers'}" Style="{StaticResource Text.Label}" FontSize="11.5" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{Binding SwapCountText}" Style="{StaticResource Text.Title}" FontSize="20" />
                            <TextBlock Text="{c:Tr 'Swaps'}" Style="{StaticResource Text.Label}" FontSize="11.5" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{Binding NetworksUsedText}" Style="{StaticResource Text.Title}" FontSize="20" />
                            <TextBlock Text="{c:Tr 'Networks'}" Style="{StaticResource Text.Label}" FontSize="11.5" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{Binding Totals.Count}" Style="{StaticResource Text.Title}" FontSize="20" />
                            <TextBlock Text="{c:Tr 'Coins'}" Style="{StaticResource Text.Label}" FontSize="11.5" />
                        </StackPanel>
                    </UniformGrid>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Margin="0,6,-10,0"
                                  Padding="0,0,10,0">
                        <StackPanel>
                            <Border Style="{StaticResource Divider}" Margin="0,10,0,10" Visibility="{Binding HasTotals, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{c:Tr 'Sent'}" Style="{StaticResource Text.Label}" FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}"
                                       Visibility="{Binding HasTotals, Converter={StaticResource BoolToVis}}" />
                            <ItemsControl ItemsSource="{Binding Totals}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,7">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <c:CoinIcon Source="{Binding IconPath}" Initial="{Binding Initial}" Size="22" />
                                            <TextBlock Grid.Column="1" Text="{Binding CountText}" Style="{StaticResource Text.Label}" FontSize="12" Margin="10,0,0,0"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding AmountText}" FontSize="12.5" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border Style="{StaticResource Divider}" Margin="0,10,0,10" Visibility="{Binding HasFees, Converter={StaticResource BoolToVis}}" />
                            <TextBlock Text="{c:Tr 'Fees paid'}" Style="{StaticResource Text.Label}" FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}"
                                       Visibility="{Binding HasFees, Converter={StaticResource BoolToVis}}" />
                            <ItemsControl ItemsSource="{Binding Fees}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,7">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <c:CoinIcon Source="{Binding IconPath}" Initial="{Binding Initial}" Size="22" />
                                            <TextBlock Grid.Column="1" Text="{Binding CountText}" Style="{StaticResource Text.Label}" FontSize="12" Margin="10,0,0,0"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding AmountText}" FontSize="12.5" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Margin="0,26,0,0" HorizontalAlignment="Center" Visibility="{Binding HasTotals, Converter={StaticResource BoolToVisInverse}}">
                                <TextBlock Text="&#xE81C;" FontFamily="{StaticResource IconFont}" FontSize="20" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextTertiaryBrush}" />
                                <TextBlock Text="{c:Tr 'Your totals show up after the first send'}" Style="{StaticResource Text.Label}" FontSize="12" Margin="0,8,0,0"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                    <StackPanel Grid.Row="3">
                        <Border Style="{StaticResource Divider}" Margin="0,10,0,12" />
                        <Grid>
                            <TextBlock Text="{c:Tr 'Last transfer'}" Style="{StaticResource Text.Label}" FontSize="12" />
                            <TextBlock Text="{Binding LastText}" FontSize="12" HorizontalAlignment="Right" />
                        </Grid>
                        <TextBlock Text="{c:Tr 'Kept only on this computer'}" Style="{StaticResource Text.Label}" FontSize="11" Margin="0,10,0,0"
                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <Border Grid.ColumnSpan="3" Background="#B0000000" Visibility="{Binding IsReceiptOpen, Converter={StaticResource BoolToVis}}" Margin="-10,-10,-10,-10"
                MouseLeftButtonDown="Scrim_Click">
            <Border Style="{StaticResource Card}" Width="640" MaxHeight="640" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="0"
                    MouseLeftButtonDown="Card_Click">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="14,14,0,0" Padding="24,22,24,20">
                        <Grid>
                            <Button Style="{StaticResource Button.Icon}" Content="&#xE711;" Width="30" Height="30" FontSize="11" HorizontalAlignment="Right"
                                    VerticalAlignment="Top" Command="{Binding CloseReceiptCommand}" ToolTip="{c:Tr 'Close'}" />
                            <StackPanel HorizontalAlignment="Center">
                                <Border Width="48" Height="48" CornerRadius="24" Background="{DynamicResource SurfaceBrush}" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding ReceiptGlyph}" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="{DynamicResource TextBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{Binding ReceiptStatusText}" Style="{StaticResource Text.Label}" HorizontalAlignment="Center" Margin="0,12,0,0" />
                                <TextBlock Text="{Binding ReceiptAmountText}" Style="{StaticResource Text.Title}" FontSize="26" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                                    <Border Style="{StaticResource Chip.Static}" Padding="6,0">
                                        <TextBlock Text="{Binding ReceiptNetworkText}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" />
                                    </Border>
                                    <TextBlock Text="{Binding ReceiptDateText}" Style="{StaticResource Text.Label}" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False" Padding="24,6,24,6">
                        <ItemsControl ItemsSource="{Binding ReceiptRows}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0">
                                        <Border Height="1" VerticalAlignment="Bottom" Background="{DynamicResource BorderSubtleBrush}" Opacity="0.7" />
                                        <Grid Margin="0,11">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Label}" FontSize="12" VerticalAlignment="Top" Margin="0,1,0,0" />
                                        <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" FontSize="12.5" />
                                        <Button Grid.Column="2" Style="{StaticResource Button.Icon}" Content="&#xE7B3;" Width="26" Height="26" FontSize="12" VerticalAlignment="Top"
                                                Visibility="{Binding Trackable, Converter={StaticResource BoolToVis}}" ToolTip="{c:Tr 'Follow this payment'}"
                                                Command="{Binding DataContext.TrackPaymentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                        <Button Grid.Column="2" Style="{StaticResource Button.Icon}" Content="&#xE8C8;" Width="26" Height="26" FontSize="11" VerticalAlignment="Top"
                                                Visibility="{Binding Copyable, Converter={StaticResource BoolToVis}}" ToolTip="{c:Tr 'Copy'}"
                                                Command="{Binding DataContext.CopyRowCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <StackPanel Grid.Row="2" Margin="24,8,24,22">
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="{c:Tr 'Receipt language'}" Style="{StaticResource Text.Label}" FontSize="12" VerticalAlignment="Center" />
                            <ComboBox ItemsSource="{Binding AllLanguages}" SelectedItem="{Binding SelectedReceiptLanguage, Mode=TwoWay}" DisplayMemberPath="Name"
                                      Style="{StaticResource Select}" Width="200" HorizontalAlignment="Right" />
                        </Grid>
                        <Button Style="{StaticResource Button.Primary}" Command="{Binding SpeedUpCommand}" Padding="16,10" HorizontalAlignment="Stretch" Margin="0,0,0,8"
                                Visibility="{Binding ReceiptCanSpeedUp, Converter={StaticResource BoolToVis}}" Content="{c:Tr 'Speed up'}" />
                        <Button Style="{StaticResource Button.Secondary}" Command="{Binding CancelPaymentCommand}" Padding="16,10" HorizontalAlignment="Stretch" Margin="0,0,0,8"
                                Visibility="{Binding ReceiptCanSpeedUp, Converter={StaticResource BoolToVis}}" Content="{c:Tr 'Cancel payment'}" />
                        <Button Style="{StaticResource Button.Primary}" Command="{Binding RetryCommand}" Padding="16,10" HorizontalAlignment="Stretch" Margin="0,0,0,8"
                                Visibility="{Binding ReceiptCanRetry, Converter={StaticResource BoolToVis}}" Content="{c:Tr 'Send again'}" />
                        <Button Style="{StaticResource Button.Secondary}" Command="{Binding TrackPaymentCommand}" Padding="16,10" HorizontalAlignment="Stretch" Margin="0,0,0,8"
                                Visibility="{Binding ReceiptCanTrack, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7B3;" FontFamily="{StaticResource IconFont}" FontSize="12" Margin="0,1,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="{c:Tr 'Follow this payment'}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Button.Primary}" Command="{Binding DownloadReceiptCommand}" Padding="16,10" HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="12" Margin="0,1,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="{c:Tr 'Download receipt'}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Button.Secondary}" Command="{Binding OpenTxCommand}" CommandParameter="{Binding ReceiptItem}" Padding="16,10"
                                HorizontalAlignment="Stretch" Margin="0,8,0,0" Visibility="{Binding ReceiptHasExplorer, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{c:Tr 'View in explorer'}" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>