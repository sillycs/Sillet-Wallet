<UserControl x:Class="Sillet.App.Views.WalletConnectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Sillet.App.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="0,10,0,20" MaxWidth="640" HorizontalAlignment="Left">
            <Border Style="{StaticResource Card}" Padding="28,24" c:Anim.Enter="True">
                <StackPanel>
                    <TextBlock Text="{c:Tr 'Connect to apps'}" Style="{StaticResource Text.Title}" FontSize="22" />
                    <TextBlock Text="{c:Tr 'Use WalletConnect to sign in to an app or website. On the app, choose WalletConnect and copy its link (it starts with wc:), then paste it here'}"
                               Style="{StaticResource Text.Label}" TextWrapping="Wrap" Margin="0,6,0,16" LineHeight="19" />

                    <StackPanel Visibility="{Binding IsNotReady, Converter={StaticResource BoolToVis}}">
                        <Border Style="{StaticResource Notice.Warning}" Padding="12,9">
                            <TextBlock Text="{c:Tr 'WalletConnect is not ready in this version'}" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsReady, Converter={StaticResource BoolToVis}}">
                        <TextBox Style="{StaticResource Input}" Text="{Binding LinkText, UpdateSourceTrigger=PropertyChanged}" />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="{c:Tr 'Connect'}" Style="{StaticResource Button.Primary}" Command="{Binding ConnectCommand}" MinWidth="120" />
                            <Button Content="{c:Tr 'Paste'}" Style="{StaticResource Button.Secondary}" Command="{Binding PasteCommand}" Margin="8,0,0,0" />
                            <Button Content="{c:Tr 'Scan QR'}" Style="{StaticResource Button.Secondary}" Command="{Binding ScanImageCommand}" Margin="8,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="{Binding Status}" Style="{StaticResource Text.Label}" Margin="0,12,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="28,22" Margin="0,14,0,0" c:Anim.Enter="True" c:Anim.Delay="80"
                    Visibility="{Binding IsReady, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="{c:Tr 'Connected apps'}" Style="{StaticResource Text.Subtitle}" />
                    <TextBlock Text="{c:Tr 'No apps are connected'}" Style="{StaticResource Text.Label}" Margin="0,10,0,0"
                               Visibility="{Binding HasNoSessions, Converter={StaticResource BoolToVis}}" />
                    <ItemsControl ItemsSource="{Binding Sessions}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Host}" Style="{StaticResource Text.Label}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="{c:Tr 'Disconnect'}" Style="{StaticResource Button.Secondary}"
                                            Command="{Binding DisconnectCommand}" CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
