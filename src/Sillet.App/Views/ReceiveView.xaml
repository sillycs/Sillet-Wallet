<UserControl x:Class="Sillet.App.Views.ReceiveView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Sillet.App.Controls">
    <Grid Margin="0,10,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource Card}" Padding="8,18,8,10" c:Anim.Enter="True">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{c:Tr 'Receive'}" Style="{StaticResource Text.Subtitle}" Margin="12,0,0,10" />
                <Grid DockPanel.Dock="Top" Margin="4,0,4,10">
                    <TextBox Style="{StaticResource Input}" Text="{Binding CoinQuery, UpdateSourceTrigger=PropertyChanged}"
                             Tag="{c:Tr 'Search coin by name or symbol'}" FontSize="13" Padding="34,8,10,8" />
                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}"
                               VerticalAlignment="Center" Margin="13,0,0,0" IsHitTestVisible="False" />
                </Grid>
                <TextBlock DockPanel.Dock="Top" Text="{c:Tr 'No coin found'}" Style="{StaticResource Text.Label}" HorizontalAlignment="Center" Margin="0,18"
                           Visibility="{Binding HasCoinResults, Converter={StaticResource BoolToVisInverse}}" />
                <ListBox ItemsSource="{Binding Coins}" SelectedItem="{Binding SelectedCoin, Mode=TwoWay}"
                         Style="{StaticResource List.Plain}" ItemContainerStyle="{StaticResource ListItem}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid c:Anim.Stagger="True" c:Anim.Enter="True" c:Anim.Offset="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <c:CoinIcon Source="{Binding Primary.IconPath}" Initial="{Binding Initial}" Size="28" />
                                <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Symbol}" FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Label}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <Border Grid.Column="2" Style="{StaticResource Chip.Static}" Padding="7,1" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding NetworksText}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <ScrollViewer x:Name="RightScroll" Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <Grid MinHeight="{Binding ViewportHeight, ElementName=RightScroll}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="*" MinHeight="220" />
            </Grid.RowDefinitions>

            <StackPanel>
            <Border Background="#DCEEFF" BorderBrush="#A9D3F5" BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,0,0,12"
                    Visibility="{Binding ShowRotateBanner, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="22" Height="22" CornerRadius="11" Background="#2F7FC1" VerticalAlignment="Center">
                        <TextBlock Text="i" Foreground="White" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Grid.Column="1" Text="{c:Tr 'Go to Settings to enable rotating addresses'}" Foreground="#12466E" FontSize="13"
                               TextWrapping="Wrap" Margin="12,0" VerticalAlignment="Center" />
                    <Button Grid.Column="2" Content="{c:Tr 'Open Settings'}" Command="{Binding OpenRotateSettingsCommand}" Style="{StaticResource Button.Link}" Foreground="#12466E" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <Button Grid.Column="3" Content="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="11" Command="{Binding DismissRotateBannerCommand}"
                            Style="{StaticResource Button.Link}" Foreground="#12466E" VerticalAlignment="Center" />
                </Grid>
            </Border>
            <Border Style="{StaticResource Card}" Padding="28,24" c:Anim.Enter="True" c:Anim.Delay="80">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <c:CoinIcon Source="{Binding SelectedNetwork.IconPath}" Initial="{Binding SelectedNetwork.Initial}" Size="36" />
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Title}" FontSize="19" />
                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Label}" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="{c:Tr 'Network'}" Style="{StaticResource Text.Label}" Margin="0,22,0,8" />
                        <ComboBox ItemsSource="{Binding Networks}" SelectedItem="{Binding SelectedNetwork, Mode=TwoWay}" Style="{StaticResource Select}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Network}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Text="{c:Tr 'Address'}" Style="{StaticResource Text.Label}" Margin="0,18,0,8" />
                        <Border Style="{StaticResource Card.Soft}" Padding="14,12">
                            <TextBlock Text="{Binding Address}" Style="{StaticResource Text.Mono}" FontSize="12.5" />
                        </Border>

                        <Button Command="{Binding CopyCommand}" Margin="0,12,0,0" Padding="18,11" HorizontalAlignment="Stretch">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Button.Primary}">
                                    <Setter Property="Content" Value="{c:Tr 'Copy address'}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Copied}" Value="True">
                                            <Setter Property="Content" Value="{c:Tr 'Copied'}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                    <Border Grid.Column="2" Background="#F4F4F5" CornerRadius="14" Padding="14" VerticalAlignment="Center">
                        <Image Source="{Binding Address, Converter={StaticResource QrCode}}" Width="196" Height="196"
                               RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    </Border>
                </Grid>
            </Border>
            </StackPanel>

            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="28,20,28,18" c:Anim.Enter="True" c:Anim.Delay="140">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{c:Tr 'Details'}" Style="{StaticResource Text.Subtitle}" />
                    <UniformGrid Grid.Row="1" Columns="1" Margin="0,4,0,0" ClipToBounds="True">
                        <Border BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{c:Tr 'Coin'}" Style="{StaticResource Text.Label}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding CoinText}" HorizontalAlignment="Right" FontSize="13" TextTrimming="CharacterEllipsis"
                                           Margin="16,0,0,0" />
                            </Grid>
                        </Border>
                        <Border BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{c:Tr 'Network'}" Style="{StaticResource Text.Label}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding NetworkText}" HorizontalAlignment="Right" FontSize="13" TextTrimming="CharacterEllipsis"
                                           Margin="16,0,0,0" />
                            </Grid>
                        </Border>
                        <Border BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{c:Tr 'Type'}" Style="{StaticResource Text.Label}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding TokenText}" HorizontalAlignment="Right" FontSize="13" TextTrimming="CharacterEllipsis"
                                           Margin="16,0,0,0" />
                            </Grid>
                        </Border>
                        <Border BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{c:Tr 'Balance here'}" Style="{StaticResource Text.Label}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding BalanceText}" HorizontalAlignment="Right" FontSize="13" TextTrimming="CharacterEllipsis"
                                           Margin="16,0,0,0" />
                            </Grid>
                        </Border>
                        <Border BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{c:Tr 'Derivation path'}" Style="{StaticResource Text.Label}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding PathText}" HorizontalAlignment="Right" FontSize="13" TextTrimming="CharacterEllipsis"
                                           Margin="16,0,0,0" FontFamily="{StaticResource MonoFont}" />
                            </Grid>
                        </Border>
                        <Border Visibility="{Binding HasShared, Converter={StaticResource BoolToVis}}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{c:Tr 'Same address on'}" Style="{StaticResource Text.Label}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding SharedText}" HorizontalAlignment="Right" FontSize="13" TextTrimming="CharacterEllipsis"
                                           Margin="16,0,0,0" ToolTip="{Binding SharedText}" />
                            </Grid>
                        </Border>
                        <Border>
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{c:Tr 'Explorer'}" Style="{StaticResource Text.Label}" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Style="{StaticResource Button.Link}" Command="{Binding OpenExplorerCommand}" HorizontalAlignment="Right" FontSize="13">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{c:Tr 'View address'}" />
                                        <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource IconFont}" FontSize="10" Margin="6,1,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </UniformGrid>
                    <Border Grid.Row="2" Style="{StaticResource Notice.Warning}" Margin="0,10,0,0" Padding="12,9">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="11.5" Foreground="{DynamicResource WarningBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding WarningText}" FontSize="11.5" Foreground="{DynamicResource WarningBrush}" Margin="8,0,0,0"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                       ToolTip="{Binding WarningText}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
