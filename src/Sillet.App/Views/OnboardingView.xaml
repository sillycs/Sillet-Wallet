<UserControl x:Class="Sillet.App.Views.OnboardingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Sillet.App.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <Grid Width="460" Margin="0,40,0,80" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Visibility="{Binding StepIndex, Converter={StaticResource EqualsToVis}, ConverterParameter=0}">
                <TextBlock Text="{Binding WelcomeTitle}" Style="{StaticResource Text.Wordmark}" FontSize="52" HorizontalAlignment="Center"
                           c:Anim.Enter="True" c:Anim.Offset="16" />
                <TextBlock Text="{c:Tr 'Bitcoin, Ethereum, Solana, TRON and more in one wallet'}" Style="{StaticResource Text.Caption}" FontSize="13.5"
                           HorizontalAlignment="Center" Margin="0,8,0,40" c:Anim.Enter="True" c:Anim.Delay="90" />
                <StackPanel c:Anim.Enter="True" c:Anim.Delay="180">
                    <Button Style="{StaticResource Button.Primary}" Content="{c:Tr 'Create wallet'}" Command="{Binding CreateCommand}" Padding="18,12" />
                    <Button Style="{StaticResource Button.Outline}" Content="{c:Tr 'Import recovery phrase'}" Command="{Binding ImportCommand}" Padding="18,12" Margin="0,8,0,0" />
                <Button Style="{StaticResource Button.Outline}" Command="{Binding WatchCommand}" Padding="18,12" Margin="0,8,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xEA18;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" />
                        <TextBlock Text="{c:Tr 'Watch a hardware wallet'}" Margin="9,0,0,0" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Button.Link}" Content="{c:Tr 'Restore from a backup file'}" Command="{Binding RestoreBackupCommand}"
                        HorizontalAlignment="Center" Margin="0,14,0,0" FontSize="12.5" />
                <Button Style="{StaticResource Button.Link}" Content="{c:Tr 'Back to my wallets'}" Command="{Binding CancelAddCommand}"
                        HorizontalAlignment="Center" Margin="0,10,0,0" FontSize="12.5" Visibility="{Binding CanCancelAdd, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </StackPanel>

            <StackPanel Visibility="{Binding StepIndex, Converter={StaticResource EqualsToVis}, ConverterParameter=1}" c:Anim.Enter="True">
                <TextBlock Text="{c:Tr 'Recovery phrase'}" Style="{StaticResource Text.Title}" />
                <TextBlock Text="{c:Tr 'Write it down on paper, in order. It is the only way to recover your wallet'}"
                           Style="{StaticResource Text.Caption}" Margin="0,6,0,22" />
                <ItemsControl ItemsSource="{Binding Words}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card.Soft}" Margin="0,0,6,6" Padding="12,10" c:Anim.Stagger="True" c:Anim.Enter="True" c:Anim.Offset="5">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Number}" Style="{StaticResource Text.Label}" FontSize="11" Width="20" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextTertiaryBrush}" />
                                    <TextBlock Text="{Binding Word}" FontFamily="{StaticResource MonoFont}" FontSize="14" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{c:Tr 'Do not share it or store it in photos or the cloud. Whoever has it controls your funds'}"
                           Style="{StaticResource Text.Label}" FontSize="12" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Margin="0,12,0,0" />
                <CheckBox Style="{StaticResource Check}" IsChecked="{Binding SavedConfirmed, Mode=TwoWay}" Margin="0,20,0,0"
                          Content="{c:Tr 'I wrote it down and stored it somewhere safe'}" />
            </StackPanel>

            <StackPanel Visibility="{Binding StepIndex, Converter={StaticResource EqualsToVis}, ConverterParameter=2}" c:Anim.Enter="True">
                <TextBlock Text="{c:Tr 'Confirm the phrase'}" Style="{StaticResource Text.Title}" />
                <TextBlock Text="{c:Tr 'Type these two words'}" Style="{StaticResource Text.Caption}" Margin="0,6,0,22" />
                <TextBlock Style="{StaticResource Text.Label}" Margin="0,0,0,8">
                    <Run Text="{c:Tr 'Word '}" /><Run Text="{Binding VerifyIndexA, Mode=OneWay}" />
                </TextBlock>
                <TextBox Style="{StaticResource Input.Mono}" Text="{Binding VerifyA, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Style="{StaticResource Text.Label}" Margin="0,16,0,8">
                    <Run Text="{c:Tr 'Word '}" /><Run Text="{Binding VerifyIndexB, Mode=OneWay}" />
                </TextBlock>
                <TextBox Style="{StaticResource Input.Mono}" Text="{Binding VerifyB, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <StackPanel Visibility="{Binding StepIndex, Converter={StaticResource EqualsToVis}, ConverterParameter=3}" c:Anim.Enter="True">
                <TextBlock Text="{c:Tr 'Import'}" Style="{StaticResource Text.Title}" />
                <TextBlock Text="{c:Tr 'Your 12 or 24 words, separated by spaces'}" Style="{StaticResource Text.Caption}" Margin="0,6,0,22" />
                <TextBox Style="{StaticResource Input.Mono}" Text="{Binding ImportText, UpdateSourceTrigger=PropertyChanged}" Tag="word1 word2 word3"
                         TextWrapping="Wrap" AcceptsReturn="False" Height="104" VerticalContentAlignment="Top" />
            </StackPanel>

            <StackPanel Visibility="{Binding StepIndex, Converter={StaticResource EqualsToVis}, ConverterParameter=4}" c:Anim.Enter="True">
                <TextBlock Text="{c:Tr 'Password'}" Style="{StaticResource Text.Title}" />
                <TextBlock Text="{c:Tr 'Protects the wallet on this computer. At least 8 characters'}" Style="{StaticResource Text.Caption}" Margin="0,6,0,22" />
                <PasswordBox x:Name="PasswordBox1" Style="{StaticResource Password}" c:Field.Holder="{c:Tr 'New password'}" PasswordChanged="Password1_Changed" />
                <Grid Margin="2,10,2,0" Visibility="{Binding HasStrength, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Height="5" VerticalAlignment="Center">
                        <Border CornerRadius="2.5" Background="{DynamicResource SurfacePressedBrush}" />
                        <Border CornerRadius="2.5" RenderTransformOrigin="0,0.5">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource PositiveBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StrengthScore}" Value="0">
                                            <Setter Property="Background" Value="{DynamicResource NegativeBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StrengthScore}" Value="1">
                                            <Setter Property="Background" Value="{DynamicResource NegativeBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StrengthScore}" Value="2">
                                            <Setter Property="Background" Value="{DynamicResource WarningBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="{Binding StrengthValue, Mode=OneWay}" />
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                    <TextBlock Grid.Column="1" Text="{Binding StrengthText}" Style="{StaticResource Text.Label}" FontSize="11.5" Margin="10,0,0,0" />
                </Grid>
                <TextBlock Text="{c:Tr 'Repeat'}" Style="{StaticResource Text.Label}" Margin="0,14,0,8" />
                <PasswordBox x:Name="PasswordBox2" Style="{StaticResource Password}" c:Field.Holder="{c:Tr 'Repeat password'}" PasswordChanged="Password2_Changed" KeyDown="Password2_KeyDown" />
                <TextBlock Text="{c:Tr 'Passphrase, optional'}" Style="{StaticResource Text.Label}" Margin="0,22,0,4" />
                <TextBlock Text="{c:Tr 'A passphrase opens a different, hidden wallet from the same words. If you lose it, those funds cannot be recovered'}" Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,0,0,8" />
                <PasswordBox x:Name="PassphraseBox1" Style="{StaticResource Password}" c:Field.Holder="{c:Tr 'Passphrase'}" PasswordChanged="Passphrase1_Changed" />
                <PasswordBox x:Name="PassphraseBox2" Style="{StaticResource Password}" c:Field.Holder="{c:Tr 'Repeat passphrase'}" PasswordChanged="Passphrase2_Changed" Margin="0,8,0,0" />
            </StackPanel>

            <StackPanel Grid.Row="1">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StepIndex}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <TextBlock Text="{Binding Error}" Foreground="{DynamicResource NegativeBrush}" FontSize="12.5" TextWrapping="Wrap" Margin="2,16,0,0"
                           Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />

                <Grid Margin="0,26,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource Button.Ghost}" Content="{c:Tr 'Back'}" Command="{Binding BackCommand}" Padding="14,11"
                            Visibility="{Binding CanGoBack, Converter={StaticResource BoolToVis}}" />
                    <Button Style="{StaticResource Button.Ghost}" Content="{c:Tr 'Cancel'}" Command="{Binding CancelRestoreCommand}" Padding="14,11"
                            Visibility="{Binding CanCancelRestore, Converter={StaticResource BoolToVis}}" />

                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                        <Button Style="{StaticResource Button.Primary}" Content="{c:Tr 'Continue'}" Command="{Binding ContinueFromPhraseCommand}" Padding="22,11"
                                Visibility="{Binding StepIndex, Converter={StaticResource EqualsToVis}, ConverterParameter=1}" />
                        <Button Style="{StaticResource Button.Primary}" Content="{c:Tr 'Confirm'}" Command="{Binding VerifyCommand}" Padding="22,11"
                                Visibility="{Binding StepIndex, Converter={StaticResource EqualsToVis}, ConverterParameter=2}" />
                        <Button Style="{StaticResource Button.Primary}" Content="{c:Tr 'Continue'}" Command="{Binding ImportNextCommand}" Padding="22,11"
                                Visibility="{Binding StepIndex, Converter={StaticResource EqualsToVis}, ConverterParameter=3}" />
                        <Button Style="{StaticResource Button.Primary}" Command="{Binding FinishCommand}" Padding="22,11"
                                Visibility="{Binding StepIndex, Converter={StaticResource EqualsToVis}, ConverterParameter=4}">
                            <StackPanel Orientation="Horizontal">
                                <Control Style="{StaticResource Spinner}" Foreground="{DynamicResource OnAccentBrush}" Width="14" Height="14" Margin="0,0,10,0"
                                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                                <TextBlock Text="Enter" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
