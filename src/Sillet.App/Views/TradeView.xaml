<UserControl x:Class="Sillet.App.Views.TradeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Sillet.App.Controls">
    <UserControl.Resources>
        <DataTemplate x:Key="AssetChoice">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <c:CoinIcon Source="{Binding IconPath}" Initial="{Binding Initial}" Size="22" />
                <TextBlock Grid.Column="1" Text="{Binding Symbol}" FontWeight="SemiBold" FontSize="13.5" Margin="10,0,0,0" VerticalAlignment="Center" />
                <Border Grid.Column="2" Style="{StaticResource Chip.Static}" Padding="7,1" Margin="10,0,0,0">
                    <TextBlock Text="{Binding Network}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" />
                </Border>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="CoinChoice">
            <StackPanel Orientation="Horizontal">
                <c:CoinIcon Source="{Binding Primary.IconPath}" Initial="{Binding Initial}" Size="22" />
                <TextBlock Text="{Binding Symbol}" FontWeight="SemiBold" FontSize="13.5" Margin="10,0,0,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Label}" Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="NetworkChoice">
            <TextBlock Text="{Binding Network}" />
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="0,10,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="340" />
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource Card}" Padding="28,22" c:Anim.Enter="True">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="{c:Tr 'Trade'}" Style="{StaticResource Text.Title}" FontSize="19" VerticalAlignment="Center" />
                        <Border Style="{StaticResource SegmentHost}" HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Segment}" GroupName="TradeTab" Content="{c:Tr 'Swap'}" IsChecked="{Binding IsSwapTab, Mode=TwoWay}" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="TradeTab" Content="{c:Tr 'Buy'}" IsChecked="{Binding IsBuyTab, Mode=TwoWay}" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="TradeTab" Content="{c:Tr 'Sell'}" IsChecked="{Binding IsSellTab, Mode=TwoWay}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <StackPanel Margin="0,22,0,0" Visibility="{Binding IsSwapTab, Converter={StaticResource BoolToVis}}">
                        <Border Style="{StaticResource Card.Soft}" Padding="18,16">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="{c:Tr 'You send'}" Style="{StaticResource Text.Label}" />
                                    <TextBlock Text="{Binding FromBalanceText}" Style="{StaticResource Text.Label}" FontSize="12" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="230" />
                                    </Grid.ColumnDefinitions>
                                    <Grid>
                                        <TextBox Style="{StaticResource Input.Big}" Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}" Tag="0" Padding="14,10,70,10" />
                                        <Button Style="{StaticResource Button.Max}" Content="{c:Tr 'Max'}" Command="{Binding MaxCommand}" />
                                    </Grid>
                                    <ComboBox Grid.Column="2" ItemsSource="{Binding Assets}" SelectedItem="{Binding From, Mode=TwoWay}" Style="{StaticResource Select}"
                                              ItemTemplate="{StaticResource AssetChoice}" MaxDropDownHeight="360" VerticalContentAlignment="Center" />
                                </Grid>
                                <TextBlock Text="{Binding FromFiatText}" Style="{StaticResource Text.Label}" FontSize="12" Margin="2,8,0,0" />
                            </StackPanel>
                        </Border>

                        <Grid Height="14" Panel.ZIndex="1">
                            <Button Style="{StaticResource Button.Secondary}" Command="{Binding SwitchCommand}" Width="36" Height="36" Padding="0"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-12" ToolTip="{c:Tr 'Switch'}">
                                <TextBlock Text="&#xE8CB;" FontFamily="{StaticResource IconFont}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Button>
                        </Grid>

                        <Border Style="{StaticResource Card.Soft}" Padding="18,16">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="{c:Tr 'You receive'}" Style="{StaticResource Text.Label}" />
                                    <TextBlock Text="{Binding ToBalanceText}" Style="{StaticResource Text.Label}" FontSize="12" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="230" />
                                    </Grid.ColumnDefinitions>
                                    <Grid VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ReceiveText}" FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="SemiBold"
                                                   Margin="14,0,0,0" TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding IsQuoting, Converter={StaticResource BoolToVisInverse}}" />
                                        <Control Style="{StaticResource Spinner}" Width="18" Height="18" HorizontalAlignment="Left" Margin="16,0,0,0"
                                                 Visibility="{Binding IsQuoting, Converter={StaticResource BoolToVis}}" />
                                    </Grid>
                                    <ComboBox Grid.Column="2" ItemsSource="{Binding Assets}" SelectedItem="{Binding To, Mode=TwoWay}" Style="{StaticResource Select}"
                                              ItemTemplate="{StaticResource AssetChoice}" MaxDropDownHeight="360" />
                                </Grid>
                                <TextBlock Text="{Binding ReceiveFiatText}" Style="{StaticResource Text.Label}" FontSize="12" Margin="2,8,0,0" />
                            </StackPanel>
                        </Border>

                        <Grid Margin="4,14,4,0">
                            <TextBlock Text="{Binding RateText}" Style="{StaticResource Text.Label}" FontSize="12" />
                            <TextBlock Text="{Binding MinText}" Style="{StaticResource Text.Label}" FontSize="12" HorizontalAlignment="Right"
                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                        </Grid>

                        <Border Style="{StaticResource Notice.Error}" Margin="0,14,0,0" Visibility="{Binding HasQuoteError, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding QuoteError}" Foreground="{DynamicResource NegativeBrush}" TextWrapping="Wrap" FontSize="12.5" />
                        </Border>

                        <Button Style="{StaticResource Button.Primary}" Command="{Binding SwapCommand}" Margin="0,18,0,0" Padding="18,12" HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal">
                                <Control Style="{StaticResource Spinner}" Foreground="{DynamicResource OnAccentBrush}" Width="14" Height="14" Margin="0,0,10,0"
                                         Visibility="{Binding IsSwapping, Converter={StaticResource BoolToVis}}" />
                                <TextBlock Text="{c:Tr 'Swap'}" />
                            </StackPanel>
                        </Button>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                            <TextBlock Style="{StaticResource Text.Label}" FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}">
                                <Run Text="{c:Tr 'Exchanged by '}" /><Run Text="{Binding ProviderName, Mode=OneWay}" /><Run Text="{c:Tr ', no account needed  ·  '}" />
                            </TextBlock>
                            <Button Style="{StaticResource Button.Link}" Content="{c:Tr 'Terms'}" FontSize="11.5" Command="{Binding OpenTermsCommand}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Margin="0,22,0,0" Visibility="{Binding IsRampTab, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{c:Tr 'Coin'}" Style="{StaticResource Text.Label}" Margin="0,0,0,8" />
                                <ComboBox ItemsSource="{Binding Coins}" SelectedItem="{Binding RampCoin, Mode=TwoWay}" Style="{StaticResource Select}"
                                          ItemTemplate="{StaticResource CoinChoice}" MaxDropDownHeight="360" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{c:Tr 'Network'}" Style="{StaticResource Text.Label}" Margin="0,0,0,8" />
                                <ComboBox ItemsSource="{Binding RampNetworks}" SelectedItem="{Binding RampNetwork, Mode=TwoWay}" Style="{StaticResource Select}"
                                          ItemTemplate="{StaticResource NetworkChoice}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{c:Tr 'Your address'}" Style="{StaticResource Text.Label}" Margin="0,18,0,8" />
                        <Grid>
                            <Border Style="{StaticResource Card.Soft}" Padding="14,12,44,12">
                                <TextBlock Text="{Binding RampAddress}" Style="{StaticResource Text.Mono}" FontSize="12.5" />
                            </Border>
                            <Button Style="{StaticResource Button.Icon}" Content="&#xE8C8;" Width="30" Height="30" FontSize="12" HorizontalAlignment="Right"
                                    Margin="0,0,6,0" Command="{Binding CopyRampAddressCommand}" ToolTip="{c:Tr 'Copy address'}" />
                        </Grid>
                        <TextBlock Text="{Binding RampHint}" Style="{StaticResource Text.Caption}" FontSize="12" Margin="2,10,0,0" />

                        <TextBlock Text="{Binding RampTitle}" Style="{StaticResource Text.Subtitle}" Margin="0,22,0,6" />
                        <ItemsControl ItemsSource="{Binding Providers}" Focusable="False" Margin="-10,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.OpenProviderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" Cursor="Hand" FocusVisualStyle="{x:Null}" HorizontalContentAlignment="Stretch"
                                            Foreground="{DynamicResource TextBrush}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <ContentControl Style="{StaticResource HoverRow}" Content="{TemplateBinding Content}" />
                                            </ControlTemplate>
                                        </Button.Template>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource SurfacePressedBrush}">
                                                <TextBlock Text="{Binding Initial}" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="13.5" />
                                                <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Label}" FontSize="12" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="&#xE8A7;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{c:Tr 'Payments happen on the provider\'s site. Sillet never sees your card or bank details'}" Style="{StaticResource Text.Label}"
                                   FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}" Margin="2,12,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="22,18" c:Anim.Enter="True" c:Anim.Delay="100">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <TextBlock Text="{c:Tr 'Your swaps'}" Style="{StaticResource Text.Subtitle}" VerticalAlignment="Center" />
                    <Button Style="{StaticResource Button.Icon}" Content="&#xE72C;" Width="30" Height="30" FontSize="12" HorizontalAlignment="Right" Margin="0,-6,-8,-6"
                            Command="{Binding RefreshSwapsCommand}" ToolTip="{c:Tr 'Refresh status'}" />
                </Grid>
                <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasSwaps, Converter={StaticResource BoolToVisInverse}}">
                    <TextBlock Text="&#xE8AB;" FontFamily="{StaticResource IconFont}" FontSize="20" HorizontalAlignment="Center" Foreground="{DynamicResource TextTertiaryBrush}" />
                    <TextBlock Text="{c:Tr 'No swaps yet'}" Style="{StaticResource Text.Caption}" Margin="0,8,0,0" HorizontalAlignment="Center" />
                    <TextBlock Text="{c:Tr 'Swaps you start here are tracked until they finish'}" Style="{StaticResource Text.Label}" FontSize="11.5"
                               Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False" Margin="-8,12,-8,0"
                              Visibility="{Binding HasSwaps, Converter={StaticResource BoolToVis}}">
                    <ItemsControl ItemsSource="{Binding Swaps}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ContentControl Style="{StaticResource HoverRow}" c:Anim.Stagger="True" c:Anim.Enter="True" c:Anim.Offset="6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="40" Height="30">
                                            <c:CoinIcon Source="{Binding FromIcon}" Initial="{Binding FromInitial}" Size="24" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                            <c:CoinIcon Source="{Binding ToIcon}" Initial="{Binding ToInitial}" Size="24" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                                        </Grid>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                            <Grid>
                                                <TextBlock Text="{Binding Title}" FontSize="13" />
                                                <Border HorizontalAlignment="Right" CornerRadius="5" Padding="6,1">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource PositiveSoftBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource NegativeSoftBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding StatusText}" FontSize="11">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource PositiveBrush}" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource NegativeBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="{Binding AmountText}" Style="{StaticResource Text.Label}" FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding DateText}" Style="{StaticResource Text.Label}" FontSize="11.5" Margin="0,2,0,0"
                                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </ContentControl>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock Grid.Row="2" Text="{c:Tr 'Status updates every few minutes while Sillet is open'}" Style="{StaticResource Text.Label}" FontSize="11.5"
                           Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center" Margin="0,12,0,0" TextWrapping="Wrap" TextAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
