<UserControl x:Class="Sillet.App.Views.SendView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Sillet.App.Controls">
    <Grid Margin="0,10,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource Card}" Padding="8,18,8,10" IsEnabled="{Binding IsFormStep}" c:Anim.Enter="True">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="{c:Tr 'Send'}" Style="{StaticResource Text.Subtitle}" Margin="12,0,0,10" />
                <ListBox ItemsSource="{Binding Coins}" SelectedItem="{Binding SelectedCoin, Mode=TwoWay}"
                         Style="{StaticResource List.Plain}" ItemContainerStyle="{StaticResource ListItem}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid c:Anim.Stagger="True" c:Anim.Enter="True" c:Anim.Offset="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <c:CoinIcon Source="{Binding Primary.IconPath}" Initial="{Binding Initial}" Size="28" />
                                <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Symbol}" FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding NetworksText}" Style="{StaticResource Text.Label}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding FiatText}" FontSize="12.5" HorizontalAlignment="Right" />
                                    <TextBlock Text="{Binding BalanceText}" Style="{StaticResource Text.Label}" FontSize="11.5" HorizontalAlignment="Right"
                                               MaxWidth="130" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <ScrollViewer x:Name="RightScroll" Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <Grid MinHeight="{Binding ViewportHeight, ElementName=RightScroll}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="*" MinHeight="230" />
            </Grid.RowDefinitions>

                <Border Style="{StaticResource Card}" Padding="30,28" 
                        c:Anim.Enter="True" c:Anim.Delay="80">
                    <Grid>
                        <TextBlock Text="{c:Tr 'Choose a coin'}" Style="{StaticResource Text.Caption}"
                                   Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisInverse}}" />

                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsFormStep}" Value="True" />
                                                <Condition Binding="{Binding HasSelection}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <StackPanel Orientation="Horizontal">
                                <c:CoinIcon Source="{Binding SelectedAsset.IconPath}" Initial="{Binding SelectedAsset.Initial}" Size="36" />
                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource Text.Title}" FontSize="19">
                                        <Run Text="{c:Tr 'Send '}" /><Run Text="{Binding SelectedAsset.Symbol, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding SelectedAsset.DisplayName}" Style="{StaticResource Text.Label}" />
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Text="{c:Tr 'Network'}" Style="{StaticResource Text.Label}" Margin="0,24,0,8" />
                            <ComboBox ItemsSource="{Binding Networks}" SelectedItem="{Binding SelectedAsset, Mode=TwoWay}" Style="{StaticResource Select}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <TextBlock Text="{Binding Network}" />
                                            <TextBlock Text="{Binding BalanceText}" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="16,0,0,0" />
                                        </Grid>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <Grid Margin="0,22,0,8">
                                <TextBlock Text="{c:Tr 'To'}" Style="{StaticResource Text.Label}" />
                                <Border Style="{StaticResource Chip.Static}" HorizontalAlignment="Right" Padding="7,1"
                                        Visibility="{Binding HasToContact, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE77B;" FontFamily="{StaticResource IconFont}" FontSize="10" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding ToContactName}" FontSize="11.5" Margin="5,0,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Grid>
                                <TextBox Style="{StaticResource Input.Mono}" Text="{Binding ToAddress, UpdateSourceTrigger=PropertyChanged}"
                                         Tag="{Binding AddressHint}" Padding="12,11,46,11" />
                                <Button Style="{StaticResource Button.Icon}" Content="&#xE77F;" HorizontalAlignment="Right" Margin="0,0,5,0"
                                        Width="30" Height="30" FontSize="13" Command="{Binding PasteCommand}" ToolTip="{c:Tr 'Paste'}" />
                            </Grid>
                            <TextBlock Text="{Binding AddressError}" Foreground="{DynamicResource NegativeBrush}" FontSize="12" Margin="2,7,0,0" TextWrapping="Wrap"
                                       Visibility="{Binding HasAddressError, Converter={StaticResource BoolToVis}}" />
                            <StackPanel Orientation="Horizontal" Margin="2,9,0,0">
                                <Button Style="{StaticResource Button.Link}" Command="{Binding ScanFileCommand}" FontSize="12" ToolTip="{c:Tr 'Read an address from a QR image'}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xED14;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock Text="{c:Tr 'Scan QR image'}" Margin="6,0,0,0" />
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="·" Foreground="{DynamicResource TextTertiaryBrush}" Margin="10,0" VerticalAlignment="Center" />
                                <Button Style="{StaticResource Button.Link}" Command="{Binding ScanClipboardCommand}" FontSize="12"
                                        ToolTip="{c:Tr 'Take a screenshot of the QR (Win + Shift + S) and click here'}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE77F;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock Text="{c:Tr 'Paste QR screenshot'}" Margin="6,0,0,0" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <Grid Margin="0,22,0,8">
                                <TextBlock Text="{c:Tr 'Amount'}" Style="{StaticResource Text.Label}" />
                                <TextBlock Text="{Binding AvailableText}" Style="{StaticResource Text.Label}" FontSize="12" HorizontalAlignment="Right" />
                            </Grid>
                            <Grid>
                                <TextBox Style="{StaticResource Input.Big}" Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}" Tag="0" Padding="14,11,190,11" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,0">
                                    <Button Style="{StaticResource Button.Secondary}" Command="{Binding ToggleAmountModeCommand}" Padding="10,0" Height="28" FontSize="12" Margin="0,0,6,0"
                                            ToolTip="{c:Tr 'Switch between coin and currency'}" Visibility="{Binding CanToggleAmountMode, Converter={StaticResource BoolToVis}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding AmountUnit}" FontWeight="SemiBold" />
                                            <TextBlock Text="&#xE8AB;" FontFamily="{StaticResource IconFont}" FontSize="10" Margin="7,1,7,0" VerticalAlignment="Center" Foreground="{DynamicResource TextTertiaryBrush}" />
                                            <TextBlock Text="{Binding OtherUnit}" Foreground="{DynamicResource TextTertiaryBrush}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource Button.Max}" Content="{c:Tr 'Max'}" Command="{Binding MaxCommand}" Margin="0" />
                                </StackPanel>
                            </Grid>
                            <Grid Margin="2,8,0,0">
                                <TextBlock Text="{Binding FiatEquivalentText}" Style="{StaticResource Text.Label}" FontSize="12" />
                                <TextBlock Text="{Binding FeeHint}" Style="{StaticResource Text.Label}" FontSize="12" HorizontalAlignment="Right"
                                           Foreground="{DynamicResource TextTertiaryBrush}" Visibility="{Binding HasFeeHint, Converter={StaticResource BoolToVis}}" />
                            </Grid>

                            <Grid Margin="0,16,0,0" Visibility="{Binding SupportsFeeSpeed, Converter={StaticResource BoolToVis}}">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{c:Tr 'Fee speed'}" Style="{StaticResource Text.Label}" />
                                    <TextBlock Text="{c:Tr 'Faster costs more'}" Style="{StaticResource Text.Label}" FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}" />
                                </StackPanel>
                                <Border Style="{StaticResource SegmentHost}" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource Segment}" GroupName="FeeSpeed" Content="{c:Tr 'Slow'}" IsChecked="{Binding FeeSlow, Mode=TwoWay}" />
                                        <RadioButton Style="{StaticResource Segment}" GroupName="FeeSpeed" Content="{c:Tr 'Normal'}" IsChecked="{Binding FeeNormal, Mode=TwoWay}" />
                                        <RadioButton Style="{StaticResource Segment}" GroupName="FeeSpeed" Content="{c:Tr 'Fast'}" IsChecked="{Binding FeeFast, Mode=TwoWay}" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Style="{StaticResource Notice.Error}" Margin="0,18,0,0" c:Anim.Enter="True" c:Anim.Offset="4"
                                    Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding Error}" Foreground="{DynamicResource NegativeBrush}" TextWrapping="Wrap" FontSize="12.5" />
                            </Border>

                            <Button Style="{StaticResource Button.Primary}" Command="{Binding ReviewCommand}" Margin="0,26,0,0" Padding="18,12" HorizontalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal">
                                    <Control Style="{StaticResource Spinner}" Foreground="{DynamicResource OnAccentBrush}" Width="14" Height="14" Margin="0,0,10,0"
                                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Text="{c:Tr 'Continue'}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <StackPanel Visibility="{Binding IsReviewStep, Converter={StaticResource BoolToVis}}" c:Anim.Enter="True">
                            <TextBlock Text="{c:Tr 'Confirm send'}" Style="{StaticResource Text.Title}" FontSize="19" />

                            <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="16" Padding="20,24" Margin="0,16,0,0">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="{c:Tr 'You are sending'}" Style="{StaticResource Text.Label}" FontSize="12" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding ReviewAmountText}" Style="{StaticResource Text.Display}" FontSize="36" Margin="0,8,0,0" TextWrapping="Wrap"
                                               TextAlignment="Center" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding ReviewFiatText}" Style="{StaticResource Text.Label}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="14" Padding="18,14" Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Text="{c:Tr 'To'}" Style="{StaticResource Text.Caption}" />
                                    <TextBlock Text="{Binding ReviewToText}" Style="{StaticResource Text.Mono}" TextWrapping="Wrap" Margin="0,5,0,0" />
                                    <TextBlock Text="{Binding ReviewHistoryNote}" TextWrapping="Wrap" Margin="0,8,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ReviewIsNewAddress}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="14" Padding="18,6" Margin="0,10,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{c:Tr 'Network'}" Style="{StaticResource Text.Label}" Margin="0,10" />
                                    <TextBlock Grid.Column="1" Text="{Binding ReviewNetworkText}" Margin="0,10" HorizontalAlignment="Right" />
                                    <TextBlock Grid.Row="1" Text="{c:Tr 'They receive'}" Style="{StaticResource Text.Label}" Margin="0,10" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ReviewAmountText}" Margin="0,10" HorizontalAlignment="Right" TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="2" Text="{c:Tr 'Network fee'}" Style="{StaticResource Text.Label}" Margin="0,10" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ReviewFeeText}" Margin="0,10" HorizontalAlignment="Right" TextWrapping="Wrap" />
                                    <Border Grid.Row="3" Grid.ColumnSpan="2" Style="{StaticResource Divider}" VerticalAlignment="Top" />
                                    <TextBlock Grid.Row="3" Text="{c:Tr 'You pay'}" FontWeight="SemiBold" Margin="0,12" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ReviewYouPayText}" FontWeight="Bold" Margin="0,12" HorizontalAlignment="Right" TextWrapping="Wrap" />
                                </Grid>
                            </Border>
                            <TextBlock Text="{c:Tr 'The fee is paid on top. The recipient gets the full amount'}" Style="{StaticResource Text.Label}" FontSize="12" TextWrapping="Wrap" Margin="4,10,0,12" />

                            <ItemsControl ItemsSource="{Binding Notes}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource WarningSoftBrush}" CornerRadius="10" Padding="12,9" Margin="0,0,0,8">
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource WarningBrush}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel Margin="0,16,0,0" Visibility="{Binding RequiresAddressCheck, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding AddressCheckHint}" Style="{StaticResource Text.Label}" Margin="0,0,0,8" TextWrapping="Wrap"
                                           Foreground="{DynamicResource WarningBrush}" />
                                <TextBox Style="{StaticResource Input}" Text="{Binding AddressCheck, UpdateSourceTrigger=PropertyChanged}" Tag="{c:Tr 'Last 4 characters'}"
                                         MaxLength="4" FontFamily="{StaticResource MonoFont}" Width="180" HorizontalAlignment="Left" />
                            </StackPanel>
                            <StackPanel Margin="0,16,0,0" Visibility="{Binding RequiresPassword, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{c:Tr 'Password'}" Style="{StaticResource Text.Label}" Margin="0,0,0,8" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <PasswordBox x:Name="ConfirmBox" Style="{StaticResource Password}" c:Field.Holder="{c:Tr 'Enter your password to send'}"
                                                 PasswordChanged="ConfirmBox_PasswordChanged" />
                                    <Button Grid.Column="1" Style="{StaticResource Button.Secondary}" Margin="8,0,0,0" Padding="14,0" ToolTip="{c:Tr 'Confirm with Windows Hello'}"
                                            Command="{Binding ConfirmWithHelloCommand}" Visibility="{Binding CanUseHello, Converter={StaticResource BoolToVis}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE928;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" />
                                            <TextBlock Text="Windows Hello" Margin="8,0,0,0" FontSize="12.5" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <Border Style="{StaticResource Notice.Error}" Margin="0,14,0,0" Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding Error}" Foreground="{DynamicResource NegativeBrush}" TextWrapping="Wrap" FontSize="12.5" />
                            </Border>

                            <Grid Margin="0,22,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Button Style="{StaticResource Button.Secondary}" Content="{c:Tr 'Back'}" Command="{Binding BackCommand}" Padding="20,12" />
                                <Button Grid.Column="2" Style="{StaticResource Button.Primary}" Command="{Binding ConfirmCommand}" Padding="18,12">
                                    <StackPanel Orientation="Horizontal">
                                        <Control Style="{StaticResource Spinner}" Foreground="{DynamicResource OnAccentBrush}" Width="14" Height="14" Margin="0,0,10,0"
                                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock Text="{c:Tr 'Send'}" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>

                        <StackPanel Visibility="{Binding IsDoneStep, Converter={StaticResource BoolToVis}}" Margin="0,8,0,4">
                            <Border Width="96" Height="96" CornerRadius="48" Background="{DynamicResource PositiveSoftBrush}" HorizontalAlignment="Center"
                                    c:Anim.Enter="True" c:Anim.ScaleFrom="0.5" c:Anim.Offset="0">
                                <Border Width="68" Height="68" CornerRadius="34" Background="{DynamicResource PositiveBrush}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="28" Foreground="{DynamicResource BgBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Border>
                            <StackPanel c:Anim.Enter="True" c:Anim.Delay="120">
                                <TextBlock Text="{Binding StageTitle}" Style="{StaticResource Text.Title}" FontSize="22" HorizontalAlignment="Center" Margin="0,20,0,6" />
                                <TextBlock Text="{Binding ResultAmountText}" Style="{StaticResource Text.Display}" FontSize="32" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding ResultFiatText}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" Margin="0,2,0,0"
                                           Visibility="{Binding HasResultFiat, Converter={StaticResource BoolToVis}}" />
                                <Grid HorizontalAlignment="Center" Margin="0,22,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="56" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="56" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Width="84">
                                        <Border Width="28" Height="28" CornerRadius="14" HorizontalAlignment="Center" BorderThickness="2">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding S1Active}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource PositiveBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding S1Done}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource PositiveBrush}" />
                                                            <Setter Property="BorderBrush" Value="{DynamicResource PositiveBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Ellipse Width="8" Height="8" Fill="{DynamicResource PositiveBrush}" Visibility="{Binding S1Active, Converter={StaticResource BoolToVis}}" />
                                                <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{DynamicResource BgBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Visibility="{Binding S1Done, Converter={StaticResource BoolToVis}}" />
                                            </Grid>
                                        </Border>
                                        <TextBlock Text="{c:Tr 'Pending'}" FontSize="12" HorizontalAlignment="Center" Margin="0,6,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding S1Done}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding S1Active}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    <Border Grid.Column="1" Height="2" Margin="-8,13,-8,0" VerticalAlignment="Top" CornerRadius="1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource BorderStrongBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding S1Done}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource PositiveBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                    <StackPanel Grid.Column="2" Width="84">
                                        <Border Width="28" Height="28" CornerRadius="14" HorizontalAlignment="Center" BorderThickness="2">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding S2Active}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource PositiveBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding S2Done}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource PositiveBrush}" />
                                                            <Setter Property="BorderBrush" Value="{DynamicResource PositiveBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Ellipse Width="8" Height="8" Fill="{DynamicResource PositiveBrush}" Visibility="{Binding S2Active, Converter={StaticResource BoolToVis}}" />
                                                <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{DynamicResource BgBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Visibility="{Binding S2Done, Converter={StaticResource BoolToVis}}" />
                                            </Grid>
                                        </Border>
                                        <TextBlock Text="{c:Tr 'Confirmed'}" FontSize="12" HorizontalAlignment="Center" Margin="0,6,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding S2Done}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding S2Active}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    <Border Grid.Column="3" Height="2" Margin="-8,13,-8,0" VerticalAlignment="Top" CornerRadius="1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource BorderStrongBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding S2Done}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource PositiveBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                    <StackPanel Grid.Column="4" Width="84">
                                        <Border Width="28" Height="28" CornerRadius="14" HorizontalAlignment="Center" BorderThickness="2">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding S3Active}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource PositiveBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding S3Done}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource PositiveBrush}" />
                                                            <Setter Property="BorderBrush" Value="{DynamicResource PositiveBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Ellipse Width="8" Height="8" Fill="{DynamicResource PositiveBrush}" Visibility="{Binding S3Active, Converter={StaticResource BoolToVis}}" />
                                                <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{DynamicResource BgBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Visibility="{Binding S3Done, Converter={StaticResource BoolToVis}}" />
                                            </Grid>
                                        </Border>
                                        <TextBlock Text="{c:Tr 'Sent'}" FontSize="12" HorizontalAlignment="Center" Margin="0,6,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding S3Done}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding S3Active}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding StageHint}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0" />
                                <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="16" Padding="20,8" Margin="0,22,0,0" MaxWidth="560">
                                    <ItemsControl ItemsSource="{Binding Receipt}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,9">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="120" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Caption}" VerticalAlignment="Top" Margin="0,2,0,0" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource TextBrush}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Mono}" Value="True">
                                                                        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
                                                                        <Setter Property="FontSize" Value="12" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Strong}" Value="True">
                                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <Button Grid.Column="2" Style="{StaticResource Button.Icon}" Content="&#xE8C8;" Width="26" Height="26" FontSize="11" Margin="8,-3,0,0"
                                                            VerticalAlignment="Top" ToolTip="{c:Tr 'Copy'}"
                                                            Command="{Binding DataContext.CopyRowCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                                            Visibility="{Binding Copyable, Converter={StaticResource BoolToVis}}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0">
                                    <Button Style="{StaticResource Button.Outline}" Command="{Binding OpenExplorerCommand}" Padding="16,9">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{c:Tr 'Explorer'}" />
                                            <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource IconFont}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource Button.Primary}" Content="{c:Tr 'New transfer'}" Command="{Binding NewCommand}" Margin="8,0,0,0" Padding="16,9" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            

            <Border x:Name="DropZone" Grid.Row="2" Style="{StaticResource Card}" Padding="28,20,28,16" c:Anim.Enter="True" c:Anim.Delay="140"
                    AllowDrop="True" DragEnter="DropZone_DragEnter" DragOver="DropZone_DragOver" DragLeave="DropZone_DragLeave" Drop="DropZone_Drop">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Border Style="{StaticResource SegmentHost}" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Segment}" GroupName="SendLists" Content="{c:Tr 'Recent'}" IsChecked="{Binding ShowRecent, Mode=TwoWay}" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="SendLists" Content="{c:Tr 'Contacts'}" IsChecked="{Binding ShowContacts, Mode=TwoWay}" />
                            </StackPanel>
                        </Border>
                        <Grid HorizontalAlignment="Right" Width="290" Visibility="{Binding CanSaveContact, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Style="{StaticResource Input}" Text="{Binding ContactName, UpdateSourceTrigger=PropertyChanged}" Tag="{c:Tr 'Name for this address'}"
                                     FontSize="12.5" Padding="10,6" />
                            <Button Grid.Column="1" Style="{StaticResource Button.Secondary}" Content="{c:Tr 'Save contact'}" Margin="6,0,0,0" Padding="12,7" FontSize="12"
                                    Command="{Binding SaveContactCommand}" />
                        </Grid>
                    </Grid>

                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding ShowRecentEmpty, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="&#xE81C;" FontFamily="{StaticResource IconFont}" FontSize="20" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                        <TextBlock Text="{c:Tr 'Addresses you send to show up here'}" Style="{StaticResource Text.Caption}" Margin="0,8,0,0" HorizontalAlignment="Center" />
                        <TextBlock Text="{c:Tr 'The network fee is shown before you confirm'}" Style="{StaticResource Text.Label}" FontSize="11.5"
                                   Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding ShowContactsEmpty, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="&#xE77B;" FontFamily="{StaticResource IconFont}" FontSize="20" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                        <TextBlock Text="{c:Tr 'No contacts on this network yet'}" Style="{StaticResource Text.Caption}" Margin="0,8,0,0" HorizontalAlignment="Center" />
                        <TextBlock Text="{c:Tr 'Type an address above and save it with a name'}" Style="{StaticResource Text.Label}" FontSize="11.5"
                                   Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False" Margin="-10,10,-10,0"
                                  Visibility="{Binding ShowRecentList, Converter={StaticResource BoolToVis}}">
                        <ItemsControl ItemsSource="{Binding Recipients}" Focusable="False" IsEnabled="{Binding IsFormStep}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.UseRecipientCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" Cursor="Hand" FocusVisualStyle="{x:Null}" HorizontalContentAlignment="Stretch" Foreground="{DynamicResource TextBrush}"
                                            ToolTip="{Binding Address}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <ContentControl Style="{StaticResource HoverRow}" Content="{TemplateBinding Content}" />
                                            </ControlTemplate>
                                        </Button.Template>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="30" Height="30" CornerRadius="15" Background="{DynamicResource SurfaceAltBrush}">
                                                <TextBlock Text="&#xE81C;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding ShortAddress}" FontFamily="{StaticResource MonoFont}" FontSize="12.5"
                                                       Margin="12,0,0,0" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding DetailText}" Style="{StaticResource Text.Label}" FontSize="12" VerticalAlignment="Center" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False" Margin="-10,10,-10,0"
                                  Visibility="{Binding ShowContactsList, Converter={StaticResource BoolToVis}}">
                        <ItemsControl ItemsSource="{Binding ContactList}" Focusable="False" IsEnabled="{Binding IsFormStep}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Button Command="{Binding DataContext.UseContactCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" Cursor="Hand" FocusVisualStyle="{x:Null}" HorizontalContentAlignment="Stretch" Foreground="{DynamicResource TextBrush}"
                                                ToolTip="{Binding Address}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <ContentControl Style="{StaticResource HoverRow}" Content="{TemplateBinding Content}" />
                                                </ControlTemplate>
                                            </Button.Template>
                                            <Grid Margin="0,0,40,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="30" Height="30" CornerRadius="15" Background="{DynamicResource SurfacePressedBrush}">
                                                    <TextBlock Text="{Binding Initial}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" Margin="12,0,0,0" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="2" Text="{Binding ShortAddress}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>
                                        <Button Style="{StaticResource Button.Icon}" Content="&#xE74D;" Width="28" Height="28" FontSize="11" HorizontalAlignment="Right"
                                                Margin="0,0,10,0" ToolTip="{c:Tr 'Delete contact'}"
                                                Command="{Binding DataContext.DeleteContactCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock Grid.Row="2" Text="{c:Tr 'The network fee is shown before you confirm'}" Style="{StaticResource Text.Label}"
                               FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center" Margin="0,12,0,0"
                               Visibility="{Binding ShowRecentList, Converter={StaticResource BoolToVis}}" />
                    <Border x:Name="DropHint" Grid.RowSpan="3" Margin="-14,-10,-14,-8" CornerRadius="10" Background="{DynamicResource SurfaceAltBrush}"
                            BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" Visibility="Collapsed" IsHitTestVisible="False">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="&#xED14;" FontFamily="{StaticResource IconFont}" FontSize="22" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextBrush}" />
                            <TextBlock Text="{c:Tr 'Drop to scan the QR'}" FontSize="13" Margin="0,8,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
