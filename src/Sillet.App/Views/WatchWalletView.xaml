<UserControl x:Class="Sillet.App.Views.WatchWalletView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Sillet.App.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Width="520" Margin="0,40,0,80" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border Width="52" Height="52" CornerRadius="16" Background="{DynamicResource SurfacePressedBrush}" HorizontalAlignment="Left"
                    c:Anim.Enter="True" c:Anim.ScaleFrom="0.85">
                <TextBlock Text="&#xEA18;" FontFamily="{StaticResource IconFont}" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="{c:Tr 'Watch a hardware wallet'}" Style="{StaticResource Text.Title}" Margin="0,18,0,0" c:Anim.Enter="True" c:Anim.Delay="60" />
            <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,6,0,20" LineHeight="20" c:Anim.Enter="True" c:Anim.Delay="100"
                       Text="{c:Tr 'Open Ledger Live, Trezor Suite or your device app, go to Receive for each coin and paste the address here. Sillet tracks balances and shows your receive addresses. Your keys stay on the device, so sending is done from its own app'}" />

            <Border Style="{StaticResource Card.Soft}" Padding="16,14" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="{c:Tr 'Fill it for me'}" FontWeight="SemiBold" />
                    <TextBlock Text="{c:Tr 'Copy the addresses of one of your wallets, or open a file saved with Addresses in Settings, Wallets'}" Style="{StaticResource Text.Label}"
                               FontSize="12" TextWrapping="Wrap" Margin="0,2,0,12" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox ItemsSource="{Binding Sources}" SelectedItem="{Binding Source, Mode=TwoWay}" Style="{StaticResource Select}"
                                  IsEnabled="{Binding HasSources}" ToolTip="{c:Tr 'Wallets on this computer'}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" />
                                        <TextBlock Text="{Binding KindText}" Style="{StaticResource Text.Label}" FontSize="11.5" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Grid.Column="1" Style="{StaticResource Button.Secondary}" Margin="8,0,0,0" Padding="14,0" Command="{Binding ImportFileCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" />
                                <TextBlock Text="{c:Tr 'Open a file'}" Margin="8,0,0,0" FontWeight="Normal" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Text="{c:Tr 'Name'}" Style="{StaticResource Text.Label}" Margin="0,0,0,8" />
            <TextBox Style="{StaticResource Input}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Tag="{c:Tr 'Hardware wallet'}" MaxLength="32" />

            <ItemsControl ItemsSource="{Binding Fields}" Focusable="False" Margin="0,8,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,10,0,0" c:Anim.Stagger="True" c:Anim.Enter="True" c:Anim.Offset="6">
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Label}" />
                                <TextBlock Text="{c:Tr 'Invalid address'}" FontSize="12" Foreground="{DynamicResource NegativeBrush}" HorizontalAlignment="Right"
                                           Visibility="{Binding IsInvalid, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                            <Grid>
                                <TextBox Style="{StaticResource Input.Mono}" Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" Tag="{Binding Hint}"
                                         Padding="14,10,76,10" FontSize="12.5" />
                                <Button Style="{StaticResource Button.Max}" Content="{c:Tr 'Paste'}"
                                        Command="{Binding DataContext.PasteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                            </Grid>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Style="{StaticResource Notice.Error}" Margin="0,16,0,0" Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding Error}" Foreground="{DynamicResource NegativeBrush}" TextWrapping="Wrap" FontSize="12.5" />
            </Border>

            <Grid Margin="0,22,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource Button.Secondary}" Content="{c:Tr 'Back'}" Command="{Binding CancelCommand}" Padding="20,12" />
                <Button Grid.Column="2" Style="{StaticResource Button.Primary}" Content="{c:Tr 'Start watching'}" Command="{Binding SaveCommand}" Padding="18,12" />
            </Grid>
            <TextBlock Text="{c:Tr 'Only public addresses are saved. Always confirm a receive address on the device screen before sharing it'}" Style="{StaticResource Text.Label}"
                       FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" Margin="2,14,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
