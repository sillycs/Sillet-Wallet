<UserControl x:Class="Sillet.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Sillet.App.Controls">
    <UserControl.Resources>
        <Style x:Key="Keycap" TargetType="Border">
            <Setter Property="MinWidth" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
            <Setter Property="BorderThickness" Value="1,1,1,2.5" />
            <Setter Property="TextElement.FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="TextElement.FontSize" Value="11.5" />
            <Setter Property="TextElement.FontWeight" Value="SemiBold" />
            <Style.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="HorizontalAlignment" Value="Center" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                </Style>
            </Style.Resources>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel MaxWidth="760" HorizontalAlignment="Left" Margin="0,10,8,24">
            <TextBlock Text="{c:Tr 'Settings'}" Style="{StaticResource Text.Title}" Margin="0,0,0,0" c:Anim.Enter="True" />
            <Grid Uid="fixed" Margin="0,18,0,0">
                <TextBox x:Name="SearchBox" Style="{StaticResource Input}" Padding="38,9,12,9" FontSize="13"
                         Tag="{c:Tr 'Search settings'}" TextChanged="Search_Changed" KeyDown="Search_KeyDown" />
                <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{DynamicResource TextTertiaryBrush}"
                           Margin="14,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" />
            </Grid>
            <Border Uid="fixed" Style="{StaticResource Card}" Margin="0,18,0,0" Padding="20,16" c:Anim.Enter="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="52" Height="52" CornerRadius="16" Background="{DynamicResource SurfaceAltBrush}">
                        <Image Width="28" Height="28" Source="{Binding HeroIconName, Converter={StaticResource ResourceImage}}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding HeroName}" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding HeroDetail}" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
            <TextBlock x:Name="NoResults" Uid="fixed" Text="{c:Tr 'No settings found'}" Style="{StaticResource Text.Label}" FontSize="13"
                       Margin="4,28,0,0" Visibility="Collapsed" />

            <StackPanel Orientation="Horizontal" Margin="4,26,0,10" c:Anim.Enter="True">
                <TextBlock Text="&#xE8C7;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextTertiaryBrush}" />
                <TextBlock Text="{c:Tr 'Wallets'}" Style="{StaticResource Text.Label}" FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <Border Style="{StaticResource Card}" Padding="24,10,24,16" c:Anim.Enter="True" c:Anim.Delay="40">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Wallets}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="34" Height="34" CornerRadius="10" VerticalAlignment="Top" Margin="0,2,0,0" Background="{DynamicResource SurfacePressedBrush}">
                                        <Grid>
                                            <Image Width="20" Height="20" Source="{Binding WalletIconName, Converter={StaticResource ResourceImage}}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Border CornerRadius="10" Visibility="{Binding HasPhoto, Converter={StaticResource BoolToVis}}">
                                                <Border.Background>
                                                    <ImageBrush ImageSource="{Binding PhotoPath}" Stretch="UniformToFill" />
                                                </Border.Background>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                        <TextBox Style="{StaticResource Input}" Text="{Binding Name, UpdateSourceTrigger=LostFocus}" MaxLength="32" Padding="8,5" FontSize="13"
                                                 HorizontalAlignment="Left" MinWidth="200" ToolTip="{c:Tr 'Click to rename'}" />
                                        <StackPanel Orientation="Horizontal" Margin="2,4,0,0">
                                            <TextBlock Text="{Binding KindText}" Style="{StaticResource Text.Label}" FontSize="11.5" />
                                            <TextBlock Text="{c:Tr '  ·  In use'}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource PositiveBrush}"
                                                       Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource Button.Secondary}" Content="{c:Tr 'Change photo'}" Padding="12,6" FontSize="12.5" Margin="0,0,6,0"
                                                Command="{Binding ChoosePhotoCommand}" />
                                        <Button Style="{StaticResource Button.Secondary}" Content="{c:Tr 'Remove photo'}" Padding="12,6" FontSize="12.5" Margin="0,0,6,0"
                                                Command="{Binding RemovePhotoCommand}" Visibility="{Binding HasPhoto, Converter={StaticResource BoolToVis}}" />
                                        <Button Style="{StaticResource Button.Secondary}" Content="{c:Tr 'Switch'}" Padding="12,6" FontSize="12.5" Margin="0,0,6,0"
                                                Command="{Binding SwitchCommand}" Visibility="{Binding IsOther, Converter={StaticResource BoolToVis}}" />
                                        <Button Style="{StaticResource Button.Secondary}" Content="{c:Tr 'Export'}" Padding="12,6" FontSize="12.5" Margin="0,0,6,0" ToolTip="{c:Tr 'Save an encrypted backup'}"
                                                Command="{Binding ExportCommand}" Visibility="{Binding IsSeed, Converter={StaticResource BoolToVis}}" />
                                        <Button Style="{StaticResource Button.Secondary}" Content="{c:Tr 'Addresses'}" Padding="12,6" FontSize="12.5" Margin="0,0,6,0"
                                                ToolTip="{c:Tr 'Save its public addresses to watch it on another computer or phone'}"
                                                Command="{Binding ExportWatchCommand}" Visibility="{Binding HasAddresses, Converter={StaticResource BoolToVis}}" />
                                        <Button Style="{StaticResource Button.Danger}" Content="{c:Tr 'Remove'}" Padding="12,6" FontSize="12.5"
                                                Command="{Binding RemoveCommand}" Visibility="{Binding IsWatch, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Style="{StaticResource Divider}" Margin="0,8,0,12" />
                    <WrapPanel>
                        <Button Style="{StaticResource Button.Secondary}" Command="{Binding AddWalletCommand}" Padding="14,9" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" />
                                <TextBlock Text="{c:Tr 'Create or import a wallet'}" Margin="8,0,0,0" FontWeight="Normal" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource Button.Secondary}" Command="{Binding AddWatchWalletCommand}" Padding="14,9">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xEA18;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" />
                                <TextBlock Text="{c:Tr 'Add a hardware wallet'}" Margin="8,0,0,0" FontWeight="Normal" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                    <StackPanel Orientation="Horizontal" Margin="2,12,0,0">
                        <TextBlock Text="{c:Tr 'Each wallet has its own password and phrase'}" Style="{StaticResource Text.Label}" FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
                        <ToggleButton Style="{StaticResource InfoTip}" Tag="{c:Tr 'Each wallet has its own password and recovery phrase. Export saves an encrypted backup you can open on any computer'}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <StackPanel Visibility="{Binding IsSeedWallet, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal" Margin="4,28,0,10">
                    <TextBlock Text="&#xE77B;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextTertiaryBrush}" />
                    <TextBlock Text="{c:Tr 'Accounts'}" Style="{StaticResource Text.Label}" FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <Border Style="{StaticResource Card}" Padding="24,10,24,16">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding AccountRows}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button Style="{StaticResource Button.Ghost}" Command="{Binding ChoosePhotoCommand}" Padding="0" Margin="0,0,12,0" VerticalAlignment="Top"
                                                ToolTip="{c:Tr 'Change photo'}">
                                            <Grid Width="46" Height="44">

                                            <Border Width="38" Height="38" CornerRadius="19" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{DynamicResource SurfacePressedBrush}">
                                                <Grid>
                                                    <TextBlock Text="{Binding Initial}" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    <Border CornerRadius="19" Visibility="{Binding HasPhoto, Converter={StaticResource BoolToVis}}">
                                                        <Border.Background>
                                                            <ImageBrush ImageSource="{Binding PhotoPath}" Stretch="UniformToFill" />
                                                        </Border.Background>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        
                                                <Border Width="18" Height="18" CornerRadius="9" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                        Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BgBrush}" BorderThickness="2">
                                                    <Image Width="10" Height="10" Source="{Binding WalletIconName, Converter={StaticResource ResourceImage}}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </Grid>
                                        </Button>
                                        <StackPanel Grid.Column="1">
                                            <TextBox Style="{StaticResource Input}" Text="{Binding Name, UpdateSourceTrigger=LostFocus}" MaxLength="32" Padding="8,5" FontSize="13"
                                                     HorizontalAlignment="Left" MinWidth="200" ToolTip="{c:Tr 'Click to rename'}" />
                                            <TextBlock Text="{c:Tr 'In use'}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource PositiveBrush}" Margin="2,4,0,0"
                                                       Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource Button.Secondary}" Content="{c:Tr 'Remove photo'}" Padding="12,6" FontSize="12.5" Margin="0,0,6,0"
                                                    Command="{Binding RemovePhotoCommand}" Visibility="{Binding HasPhoto, Converter={StaticResource BoolToVis}}" />
                                            <Button Style="{StaticResource Button.Secondary}" Content="{c:Tr 'Switch'}" Padding="12,6" FontSize="12.5"
                                                    Command="{Binding SwitchCommand}" Visibility="{Binding IsOther, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Style="{StaticResource Divider}" Margin="0,8,0,12" />
                        <Button Style="{StaticResource Button.Secondary}" Command="{Binding AddAccountCommand}" Padding="14,9" HorizontalAlignment="Left"
                                Visibility="{Binding CanAddAccount, Converter={StaticResource BoolToVis}}">
<StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" />
                                <TextBlock Text="{c:Tr 'Add an account'}" Margin="8,0,0,0" FontWeight="Normal" />
                            </StackPanel>
                        </Button>
                        <StackPanel Orientation="Horizontal" Margin="2,12,0,0">
                            <TextBlock Text="{c:Tr 'Addresses for each account'}" Style="{StaticResource Text.Label}" FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
                            <ToggleButton Style="{StaticResource InfoTip}" Tag="{c:Tr 'Every account has its own addresses on every network, all from the same recovery phrase. Use them to keep savings, DeFi and spending apart'}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="4,28,0,10">
                    <TextBlock Text="&#xE8D4;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextTertiaryBrush}" />
                    <TextBlock Text="{c:Tr 'Custom tokens'}" Style="{StaticResource Text.Label}" FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <Border Style="{StaticResource Card}" Padding="24,16,24,16">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding TokenRows}" Focusable="False" Visibility="{Binding HasTokens, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Symbol}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Network}" Style="{StaticResource Text.Label}" FontSize="11.5" />
                                            <TextBlock Text="{Binding Contract}" Style="{StaticResource Text.Label}" FontSize="11.5" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Style="{StaticResource Button.Danger}" Content="{c:Tr 'Remove'}" Padding="12,6" FontSize="12.5" VerticalAlignment="Center" Command="{Binding RemoveCommand}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,6">
                            <TextBlock Text="&#xE774;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{c:Tr 'Network'}" Style="{StaticResource Text.Label}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ComboBox Width="240" HorizontalAlignment="Left" ItemsSource="{Binding TokenNetworks}" SelectedItem="{Binding SelectedTokenNetwork, Mode=TwoWay}" DisplayMemberPath="Name" Style="{StaticResource Select}" />
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,6">
                            <TextBlock Text="&#xE8A5;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{c:Tr 'Contract address'}" Style="{StaticResource Text.Label}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBox Style="{StaticResource Input}" Text="{Binding TokenContract, UpdateSourceTrigger=PropertyChanged}" Padding="10,8" FontSize="13" Tag="{c:Tr 'Contract address'}" />
                        <TextBlock Text="{Binding TokenError}" Foreground="{DynamicResource NegativeBrush}" FontSize="12.5" TextWrapping="Wrap" Margin="2,8,0,0" Visibility="{Binding HasTokenError, Converter={StaticResource BoolToVis}}" />
                        <StackPanel Visibility="{Binding HasFoundToken, Converter={StaticResource BoolToVis}}" Margin="0,10,0,0">
                            <TextBlock Text="{Binding FoundTokenText}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock Text="{c:Tr 'Anyone can create a token with any name, even a copy of a real one. Add only tokens you trust and check the contract on the official site of the project'}"
                                       Style="{StaticResource Text.Label}" FontSize="11.5" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button Style="{StaticResource Button.Secondary}" Command="{Binding LookupTokenCommand}" Padding="14,9" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Text="{c:Tr 'Look up'}" Margin="8,0,0,0" FontWeight="Normal" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Button.Primary}" Grid.Column="1" Margin="8,0,0,0" Command="{Binding AddTokenCommand}" Padding="14,9" Visibility="{Binding HasFoundToken, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Text="{c:Tr 'Add token'}" Margin="8,0,0,0" FontWeight="Normal" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <TextBlock Text="{c:Tr 'Add a token by its contract address. Custom tokens show no price'}" Style="{StaticResource Text.Label}" FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}" Margin="2,12,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>


            <StackPanel Orientation="Horizontal" Margin="4,28,0,10" c:Anim.Enter="True">
                <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextTertiaryBrush}" />
                <TextBlock Text="{c:Tr 'General'}" Style="{StaticResource Text.Label}" FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <Border Style="{StaticResource Card}" Padding="24,6" c:Anim.Enter="True" c:Anim.Delay="60">
                <StackPanel>
                    <Grid Margin="0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="{c:Tr 'Language'}" />
                            <TextBlock Text="{c:Tr 'The whole app changes right away'}" Style="{StaticResource Text.Label}" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" Width="150" VerticalAlignment="Center" ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}" Style="{StaticResource Select}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                    <Border Style="{StaticResource Divider}" />
                    <Grid Margin="0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="{c:Tr 'Currency'}" />
                            <TextBlock Text="{c:Tr 'Prices and totals'}" Style="{StaticResource Text.Label}" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <Button x:Name="CurrencyButton" Style="{StaticResource Button.Outline}" Command="{Binding ToggleCurrencyPickerCommand}" Width="260"
                                    Padding="14,9" HorizontalContentAlignment="Stretch">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding SelectedCurrencyText}" TextTrimming="CharacterEllipsis" FontSize="13" />
                                    <TextBlock Grid.Column="1" Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="10" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                            <Popup IsOpen="{Binding IsCurrencyPickerOpen, Mode=TwoWay}" PlacementTarget="{Binding ElementName=CurrencyButton}" Placement="Bottom"
                                   HorizontalOffset="0" VerticalOffset="6" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                                <Border Width="400" Margin="12,0,12,16" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderStrongBrush}"
                                        BorderThickness="1" Padding="0,14,0,8">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.45" Color="Black" />
                                    </Border.Effect>
                                    <StackPanel>
                                        <TextBox Style="{StaticResource Input}" Margin="14,0,14,10" Text="{Binding CurrencyQuery, UpdateSourceTrigger=PropertyChanged}"
                                                 Tag="{c:Tr 'Search currency or country'}" />
                                        <Border Style="{StaticResource Divider}" />
                                        <TextBlock Text="{c:Tr 'No currency found'}" Style="{StaticResource Text.Label}" HorizontalAlignment="Center" Margin="0,24"
                                                   Visibility="{Binding HasCurrencyResults, Converter={StaticResource BoolToVisInverse}}" />
                                        <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto" Focusable="False">
                                            <ItemsControl ItemsSource="{Binding CurrencyResults}" Focusable="False" Margin="6,6,6,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Command="{Binding DataContext.PickCurrencyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}" Cursor="Hand" FocusVisualStyle="{x:Null}" Foreground="{DynamicResource TextBrush}"
                                                                HorizontalContentAlignment="Stretch">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="10" Padding="10,8">
                                                                        <ContentPresenter />
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <Border Width="42" Height="28" CornerRadius="3" Background="{DynamicResource SurfacePressedBrush}" VerticalAlignment="Center">
                                                                    <Grid>
                                                                        <Border CornerRadius="3" Visibility="{Binding HasFlag, Converter={StaticResource BoolToVis}}">
                                                                            <Border.Background>
                                                                                <ImageBrush ImageSource="{Binding FlagPath}" Stretch="Fill" />
                                                                            </Border.Background>
                                                                        </Border>
                                                                        <TextBlock Text="{Binding FlagEmoji}" FontFamily="Segoe UI Emoji" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                   Visibility="{Binding ShowEmoji, Converter={StaticResource BoolToVis}}" />
                                                                        <TextBlock Text="{Binding IconText}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                   Visibility="{Binding ShowText, Converter={StaticResource BoolToVis}}" />
                                                                    </Grid>
                                                                </Border>
                                                                <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Label}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>
                                                                <TextBlock Grid.Column="2" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center"
                                                                           Foreground="{DynamicResource PositiveBrush}" Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}" />
                                                            </Grid>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </StackPanel>
                    </Grid>
                    <Border Style="{StaticResource Divider}" />
                    <Grid Margin="0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="{c:Tr 'Private mode'}" />
                            <TextBlock Text="{c:Tr 'Hides balances'}" Style="{StaticResource Text.Label}" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding HideBalances, Mode=TwoWay}" VerticalAlignment="Center" />
                    </Grid>
                    <Border Style="{StaticResource Divider}" />
                    <Grid Margin="0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="{c:Tr 'Hide small balances'}" />
                            <TextBlock Text="{Binding SmallBalanceText}" Style="{StaticResource Text.Label}" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding HideSmallBalances, Mode=TwoWay}" VerticalAlignment="Center" />
                    </Grid>
                    <Border Style="{StaticResource Divider}" />
                    <Grid Margin="0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="{c:Tr 'Refresh prices'}" />
                            <TextBlock Text="{c:Tr 'How often balances and prices update'}" Style="{StaticResource Text.Label}" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Border Grid.Column="1" Style="{StaticResource SegmentHost}" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Segment}" GroupName="Refresh" Content="{c:Tr '1 min'}" IsChecked="{Binding Refresh1, Mode=TwoWay}" />
                                <RadioButton Style="{StaticResource Segment}" GroupName="Refresh" Content="{c:Tr '2 min'}" IsChecked="{Binding Refresh2, Mode=TwoWay}" />
