                                </Grid.ColumnDefinitions>
                                <Border Width="32" Height="32" CornerRadius="9" Background="{DynamicResource SurfacePressedBrush}" VerticalAlignment="Top">
                                    <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{c:Tr 'Clear cache'}" FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock Text="{c:Tr 'Icons and prices reload'}" Style="{StaticResource Text.Label}" FontSize="11.5" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource Button.Secondary}" Command="{Binding ClearActivityCommand}" Padding="14,12" Margin="0,0,8,8"
                                HorizontalContentAlignment="Stretch" FontWeight="Normal">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Border Width="32" Height="32" CornerRadius="9" Background="{DynamicResource NegativeSoftBrush}" VerticalAlignment="Top">
                                    <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="13" Foreground="{DynamicResource NegativeBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{c:Tr 'Clear activity'}" FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock Text="{c:Tr 'Funds are not affected'}" Style="{StaticResource Text.Label}" FontSize="11.5" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </Button>
                    </UniformGrid>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="24,22" c:Anim.Enter="True" c:Anim.Delay="210" Visibility="{Binding IsSeedWallet, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="{c:Tr 'Delete wallet'}" />
                    <TextBlock Text="{c:Tr 'Removes it from this computer. Your funds stay accessible with the recovery phrase'}" Style="{StaticResource Text.Label}"
                               FontSize="12" TextWrapping="Wrap" Margin="0,2,0,14" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <PasswordBox x:Name="DeleteBox" Style="{StaticResource Password}" c:Field.Holder="{c:Tr 'Password'}" PasswordChanged="DeleteBox_Changed" />
                        <Button Grid.Column="1" Style="{StaticResource Button.Danger}" Content="{c:Tr 'Delete'}" Margin="8,0,0,0" Command="{Binding DeleteCommand}" />
                    </Grid>
                    <TextBlock Text="{Binding DeleteError}" Foreground="{DynamicResource NegativeBrush}" FontSize="12" Margin="2,8,0,0"
                               Visibility="{Binding HasDeleteError, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="4,28,0,10" c:Anim.Enter="True">
                <TextBlock Text="&#xE765;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextTertiaryBrush}" />
                <TextBlock Text="{c:Tr 'Keyboard shortcuts'}" Style="{StaticResource Text.Label}" FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <Border Style="{StaticResource Card}" Padding="24,20" c:Anim.Enter="True" c:Anim.Delay="230">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="{c:Tr 'Jump to a page'}" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Border Style="{StaticResource Keycap}"><TextBlock Text="Ctrl" /></Border>
                            <TextBlock Text="+" Style="{StaticResource Text.Label}" Margin="7,0" VerticalAlignment="Center" />
                            <Border Style="{StaticResource Keycap}"><TextBlock Text="1 - 7" /></Border>
                        </StackPanel>
                    </Grid>
                    <UniformGrid Columns="7" Margin="0,14,-8,0">
                        <Border Style="{StaticResource Card.Soft}" Margin="0,0,8,0" Padding="0,12">
                            <StackPanel HorizontalAlignment="Center">
                                <Border Style="{StaticResource Keycap}" HorizontalAlignment="Center"><TextBlock Text="1" /></Border>
                                <TextBlock Text="{c:Tr 'Home'}" Style="{StaticResource Text.Label}" FontSize="11.5" Margin="0,8,0,0" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card.Soft}" Margin="0,0,8,0" Padding="0,12">
                            <StackPanel HorizontalAlignment="Center">
                                <Border Style="{StaticResource Keycap}" HorizontalAlignment="Center"><TextBlock Text="2" /></Border>
                                <TextBlock Text="{c:Tr 'Market'}" Style="{StaticResource Text.Label}" FontSize="11.5" Margin="0,8,0,0" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card.Soft}" Margin="0,0,8,0" Padding="0,12">
                            <StackPanel HorizontalAlignment="Center">
                                <Border Style="{StaticResource Keycap}" HorizontalAlignment="Center"><TextBlock Text="3" /></Border>
                                <TextBlock Text="{c:Tr 'Send'}" Style="{StaticResource Text.Label}" FontSize="11.5" Margin="0,8,0,0" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card.Soft}" Margin="0,0,8,0" Padding="0,12">
                            <StackPanel HorizontalAlignment="Center">
                                <Border Style="{StaticResource Keycap}" HorizontalAlignment="Center"><TextBlock Text="4" /></Border>
                                <TextBlock Text="{c:Tr 'Receive'}" Style="{StaticResource Text.Label}" FontSize="11.5" Margin="0,8,0,0" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card.Soft}" Margin="0,0,8,0" Padding="0,12">
                            <StackPanel HorizontalAlignment="Center">
                                <Border Style="{StaticResource Keycap}" HorizontalAlignment="Center"><TextBlock Text="5" /></Border>
                                <TextBlock Text="{c:Tr 'Trade'}" Style="{StaticResource Text.Label}" FontSize="11.5" Margin="0,8,0,0" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card.Soft}" Margin="0,0,8,0" Padding="0,12">
                            <StackPanel HorizontalAlignment="Center">
                                <Border Style="{StaticResource Keycap}" HorizontalAlignment="Center"><TextBlock Text="6" /></Border>
                                <TextBlock Text="{c:Tr 'Activity'}" Style="{StaticResource Text.Label}" FontSize="11.5" Margin="0,8,0,0" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card.Soft}" Margin="0,0,8,0" Padding="0,12">
                            <StackPanel HorizontalAlignment="Center">
                                <Border Style="{StaticResource Keycap}" HorizontalAlignment="Center"><TextBlock Text="7" /></Border>
                                <TextBlock Text="{c:Tr 'Settings'}" Style="{StaticResource Text.Label}" FontSize="11.5" Margin="0,8,0,0" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                    <Border Style="{StaticResource Divider}" Margin="0,18,0,10" />
                    <UniformGrid Columns="2">
                        <Grid Margin="0,6,22,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="30" Height="30" CornerRadius="9" Background="{DynamicResource SurfacePressedBrush}">
                                <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Border>
                            <TextBlock Grid.Column="1" Text="{c:Tr 'Search coins'}" FontSize="13" Margin="12,0,0,0" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Border Style="{StaticResource Keycap}" Margin="5,0,0,0"><TextBlock Text="Ctrl" /></Border><Border Style="{StaticResource Keycap}" Margin="5,0,0,0"><TextBlock Text="K" /></Border></StackPanel>
                        </Grid>
                        <Grid Margin="0,6,22,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="30" Height="30" CornerRadius="9" Background="{DynamicResource SurfacePressedBrush}">
                                <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Border>
                            <TextBlock Grid.Column="1" Text="{c:Tr 'Refresh now'}" FontSize="13" Margin="12,0,0,0" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Border Style="{StaticResource Keycap}" Margin="5,0,0,0"><TextBlock Text="Ctrl" /></Border><Border Style="{StaticResource Keycap}" Margin="5,0,0,0"><TextBlock Text="R" /></Border></StackPanel>
                        </Grid>
                        <Grid Margin="0,6,22,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="30" Height="30" CornerRadius="9" Background="{DynamicResource SurfacePressedBrush}">
                                <TextBlock Text="&#xED1A;" FontFamily="{StaticResource IconFont}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Border>
                            <TextBlock Grid.Column="1" Text="{c:Tr 'Hide balances'}" FontSize="13" Margin="12,0,0,0" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Border Style="{StaticResource Keycap}" Margin="5,0,0,0"><TextBlock Text="Ctrl" /></Border><Border Style="{StaticResource Keycap}" Margin="5,0,0,0"><TextBlock Text="H" /></Border></StackPanel>
                        </Grid>
                        <Grid Margin="0,6,22,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="30" Height="30" CornerRadius="9" Background="{DynamicResource SurfacePressedBrush}">
                                <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFont}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Border>
                            <TextBlock Grid.Column="1" Text="{c:Tr 'Lock wallet'}" FontSize="13" Margin="12,0,0,0" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Border Style="{StaticResource Keycap}" Margin="5,0,0,0"><TextBlock Text="Ctrl" /></Border><Border Style="{StaticResource Keycap}" Margin="5,0,0,0"><TextBlock Text="L" /></Border></StackPanel>
                        </Grid>
                        <Grid Margin="0,6,22,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="30" Height="30" CornerRadius="9" Background="{DynamicResource SurfacePressedBrush}">
                                <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Border>
                            <TextBlock Grid.Column="1" Text="{c:Tr 'Close dialog'}" FontSize="13" Margin="12,0,0,0" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Border Style="{StaticResource Keycap}" Margin="5,0,0,0"><TextBlock Text="Esc" /></Border></StackPanel>
                        </Grid>
                        <Grid Margin="0,6,22,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="30" Height="30" CornerRadius="9" Background="{DynamicResource SurfacePressedBrush}">
                                <TextBlock Text="&#xE700;" FontFamily="{StaticResource IconFont}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Border>
                            <TextBlock Grid.Column="1" Text="{c:Tr 'Collapse the menu'}" FontSize="13" Margin="12,0,0,0" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Border Style="{StaticResource Keycap}" Margin="5,0,0,0"><TextBlock Text="Ctrl" /></Border><Border Style="{StaticResource Keycap}" Margin="5,0,0,0"><TextBlock Text="B" /></Border></StackPanel>
                        </Grid>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="4,28,0,10" c:Anim.Enter="True">
                <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextTertiaryBrush}" />
                <TextBlock Text="{c:Tr 'About'}" Style="{StaticResource Text.Label}" FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <Border Style="{StaticResource Card}" Padding="24,6" c:Anim.Enter="True" c:Anim.Delay="240">
                <StackPanel>
                    <Grid Margin="0,12">
                        <TextBlock Text="{c:Tr 'Version'}" Style="{StaticResource Text.Label}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Version}" HorizontalAlignment="Right" FontSize="13" />
                    </Grid>
                    <Border Style="{StaticResource Divider}" Visibility="{Binding CanAutoUpdate, Converter={StaticResource BoolToVis}}" />
                    <Grid Margin="0,14" Visibility="{Binding CanAutoUpdate, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{c:Tr 'Update automatically'}" />
                                <ToggleButton Style="{StaticResource InfoTip}" Tag="{c:Tr 'Sillet checks every 20 minutes and shows you each new version with its changelog. Nothing is installed until you press Install update. Every update must carry a valid signature from the Sillet release key, or it is refused. Administrator permission is requested only if Sillet is installed in a protected folder'}" />
                            </StackPanel>
                            <TextBlock Text="{c:Tr 'Offers new versions and asks before installing'}" Style="{StaticResource Text.Label}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource Switch}" IsChecked="{Binding AutoUpdate, Mode=TwoWay}" VerticalAlignment="Center" />
                    </Grid>
                    <Border Style="{StaticResource Divider}" />
                    <Grid Margin="0,12">
                        <TextBlock Text="{c:Tr 'Supported'}" Style="{StaticResource Text.Label}" VerticalAlignment="Center" />
                        <TextBlock HorizontalAlignment="Right" FontSize="13">
                            <Run Text="{Binding NetworkCount, Mode=OneWay}" /><Run Text="{c:Tr ' networks, '}" /><Run Text="{Binding AssetCount, Mode=OneWay}" /><Run Text="{c:Tr ' coins'}" />
                        </TextBlock>
                    </Grid>
                    <Border Style="{StaticResource Divider}" />
                    <Grid Margin="0,12">
                        <TextBlock Text="{c:Tr 'Prices and charts'}" Style="{StaticResource Text.Label}" VerticalAlignment="Center" />
                        <StackPanel HorizontalAlignment="Right">
                            <Button Style="{StaticResource Button.Link}" Command="{Binding OpenCoinGeckoCommand}" FontSize="13">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="CoinGecko" />
                                    <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource IconFont}" FontSize="10" Margin="6,1,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <Border Style="{StaticResource Divider}" />
                    <Grid Margin="0,12">
                        <TextBlock Text="{c:Tr 'Fear and greed'}" Style="{StaticResource Text.Label}" VerticalAlignment="Center" />
                        <StackPanel HorizontalAlignment="Right">
                            <Button Style="{StaticResource Button.Link}" Command="{Binding OpenAlternativeCommand}" FontSize="13">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="alternative.me" />
                                    <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource IconFont}" FontSize="10" Margin="6,1,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <Border Style="{StaticResource Divider}" />
                    <Grid Margin="0,12">
                        <TextBlock Text="{c:Tr 'Made by'}" Style="{StaticResource Text.Label}" VerticalAlignment="Center" />
                        <StackPanel HorizontalAlignment="Right">
                            <Button Style="{StaticResource Button.Link}" Command="{Binding OpenRatonCommand}" FontSize="13">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="sillycs · raton.fun" />
                                    <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource IconFont}" FontSize="10" Margin="6,1,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
            <StackPanel Uid="fixed" HorizontalAlignment="Center" Margin="0,22,0,0">
                <TextBlock Text="{Binding Version}" Style="{StaticResource Text.Caption}" FontSize="11" Foreground="White" Opacity="0.7" HorizontalAlignment="Center" />
                <Button Style="{StaticResource Button.Link}" Command="{Binding CopyIdCommand}" Content="{c:Tr 'Copy Raton ID'}" FontSize="9.5" Foreground="White" Opacity="0.4"
                        HorizontalAlignment="Center" Margin="0,2,0,0" Padding="6,2" />
                <Button Style="{StaticResource Button.Link}" Command="{Binding ToggleDeveloperCommand}" Content="{c:Tr 'Developer mode'}" FontSize="9.5" Foreground="White" Opacity="0.4"
                        HorizontalAlignment="Center" Margin="0,2,0,0" Padding="6,2" />
            </StackPanel>
            <Border Uid="fixed" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="24,20" Visibility="{Binding IsDeveloperOpen, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="{c:Tr 'Developer mode'}" FontWeight="SemiBold" />
                    <TextBlock Text="{c:Tr 'Made-up payments, receipts and notifications. Nothing is signed or sent'}" Style="{StaticResource Text.Label}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,14" />
                    <WrapPanel>
                        <Button Style="{StaticResource Button.Secondary}" Content="{c:Tr 'Test sent payment'}" Command="{Binding DevFakeSentCommand}" Padding="14,8" Margin="0,0,8,8" />
                        <Button Style="{StaticResource Button.Secondary}" Content="{c:Tr 'Test received payment'}" Command="{Binding DevFakeReceivedCommand}" Padding="14,8" Margin="0,0,8,8" />
                        <Button Style="{StaticResource Button.Secondary}" Content="{c:Tr 'Test notifications'}" Command="{Binding DevNotificationsCommand}" Padding="14,8" Margin="0,0,8,8" />
                        <Button Style="{StaticResource Button.Secondary}" Content="{c:Tr 'Test receipt'}" Command="{Binding DevReceiptCommand}" Padding="14,8" Margin="0,0,8,8" />
                        <Button Style="{StaticResource Button.Secondary}" Content="{c:Tr 'Test large payment'}" Command="{Binding DevBigPaymentCommand}" Padding="14,8" Margin="0,0,8,8" />
                        <Button Style="{StaticResource Button.Secondary}" Content="{c:Tr 'Test 40 transfers'}" Command="{Binding DevManyEntriesCommand}" Padding="14,8" Margin="0,0,8,8" />
                        <Button Style="{StaticResource Button.Secondary}" Content="{c:Tr 'Clear test data'}" Command="{Binding DevClearCommand}" Padding="14,8" Margin="0,0,8,8" />
                    </WrapPanel>
                    <TextBlock Text="{Binding DevStatus}" Style="{StaticResource Text.Label}" FontSize="12.5" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="{Binding HasDevStatus, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
