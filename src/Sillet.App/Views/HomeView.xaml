<UserControl x:Class="Sillet.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Sillet.App.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel Margin="0,10,10,0">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel c:Anim.Enter="True">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{c:Tr 'Balance'}" Style="{StaticResource Text.Label}" VerticalAlignment="Center" />
                        <Button Command="{Binding ToggleHideCommand}" Margin="4,0,0,0" Width="28" Height="28" FontSize="13">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Button.Icon}">
                                    <Setter Property="Content" Value="&#xE890;" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HideBalances}" Value="True">
                                            <Setter Property="Content" Value="&#xED1A;" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                    <c:AnimatedAmount Value="{Binding TotalValue}" Currency="{Binding Currency}" Hidden="{Binding HideBalances}"
                                      Style="{StaticResource Text.Display}" FontSize="50" Margin="0,0,0,4" />
                    <StackPanel Orientation="Horizontal" Visibility="{Binding HasChange, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding ChangeText}" Tag="{Binding IsUp}" Style="{StaticResource Text.Change}" />
                        <TextBlock Text="{c:Tr 'today'}" Style="{StaticResource Text.Label}" Margin="8,0,0,0" />
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="34,6,16,0" Padding="22,0,0,0" BorderThickness="1,0,0,0"
                        BorderBrush="{DynamicResource BorderSubtleBrush}" c:Anim.Enter="True" c:Anim.Delay="60">
                    <StackPanel>
                        <ComboBox ItemsSource="{Binding HomeCoins}" SelectedItem="{Binding HomeCoin, Mode=TwoWay}" Style="{StaticResource Select}"
                                  MinWidth="150" HorizontalAlignment="Left" MaxDropDownHeight="360" Padding="10,5" FontSize="12.5" ToolTip="{c:Tr 'Pick a coin to follow'}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <c:CoinIcon Source="{Binding Primary.IconPath}" Initial="{Binding Initial}" Size="18" />
                                        <TextBlock Text="{Binding Symbol}" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Text.Label}" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="{Binding HomeCoinAmount}" FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="SemiBold" Margin="2,10,0,0"
                                   TextTrimming="CharacterEllipsis" />
                        <StackPanel Orientation="Horizontal" Margin="2,2,0,0">
                            <TextBlock Text="{Binding HomeCoinFiat}" Style="{StaticResource Text.Label}" FontSize="13" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding HomeCoinChangeText}" Tag="{Binding HomeCoinUp}" Style="{StaticResource Text.Change}" FontSize="12.5"
                                       Margin="8,0,0,0" VerticalAlignment="Center" Visibility="{Binding HasHomeCoinChange, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                        <TextBlock Text="{Binding HomeCoinMeta}" Style="{StaticResource Text.Label}" FontSize="11.5" Margin="2,6,0,0"
                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,2,0,0" c:Anim.Enter="True" c:Anim.Delay="80">
                    <TextBlock Text="{Binding LastUpdateText}" Style="{StaticResource Text.Label}" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <Grid Width="34" Height="34" Margin="0,0,8,0">
                        <Button Style="{StaticResource Button.Icon}" Content="&#xE72C;" Command="{Binding RefreshCommand}" ToolTip="{c:Tr 'Refresh'}"
                                Visibility="{Binding IsRefreshing, Converter={StaticResource BoolToVisInverse}}" />
                        <Control Style="{StaticResource Spinner}" Width="15" Height="15"
                                 Visibility="{Binding IsRefreshing, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                    <Button x:Name="HomeCurrencyButton" Style="{StaticResource Button.Outline}" Command="{Binding ToggleCurrencyCommand}"
                            Padding="12,6" FontSize="12" ToolTip="{Binding CurrencyToggleText}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding CurrencyLabel}" />
                            <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="9" Margin="8,1,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Popup IsOpen="{Binding CurrencyPicker.IsCurrencyPickerOpen, Mode=TwoWay}" PlacementTarget="{Binding ElementName=HomeCurrencyButton}" Placement="Bottom"
                                   HorizontalOffset="-366" VerticalOffset="6" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                                <Border DataContext="{Binding CurrencyPicker}" Width="400" Margin="12,0,12,16" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderStrongBrush}"
                                        BorderThickness="1" Padding="0,14,0,8">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.45" Color="Black" />
                                    </Border.Effect>
                                    <StackPanel>
                                        <TextBox Style="{StaticResource Input}" Margin="14,0,14,10" Text="{Binding CurrencyQuery, UpdateSourceTrigger=PropertyChanged}"
                                                 Tag="{c:Tr 'Search currency or country'}" />
                                        <Border Style="{StaticResource Divider}" />
                                        <TextBlock Text="{c:Tr 'No currency found'}" Style="{StaticResource Text.Label}" HorizontalAlignment="Center" Margin="0,24"
                                                   Visibility="{Binding HasCurrencyResults, Converter={StaticResource BoolToVisInverse}}" />
                                        <ScrollViewer MaxHeight="360" VerticalScrollBarVisibility="Auto" Focusable="False">
                                            <ItemsControl ItemsSource="{Binding CurrencyResults}" Focusable="False" Margin="6,6,6,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Command="{Binding DataContext.PickCurrencyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}" Cursor="Hand" FocusVisualStyle="{x:Null}" Foreground="{DynamicResource TextBrush}"
                                                                HorizontalContentAlignment="Stretch">
                                                            <Button.Template>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="10" Padding="10,8">
                                                                        <ContentPresenter />
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Button.Template>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <Border Width="42" Height="28" CornerRadius="3" Background="{DynamicResource SurfacePressedBrush}" VerticalAlignment="Center">
                                                                    <Grid>
                                                                        <Border CornerRadius="3" Visibility="{Binding HasFlag, Converter={StaticResource BoolToVis}}">
                                                                            <Border.Background>
                                                                                <ImageBrush ImageSource="{Binding FlagPath}" Stretch="Fill" />
                                                                            </Border.Background>
                                                                        </Border>
                                                                        <TextBlock Text="{Binding FlagEmoji}" FontFamily="Segoe UI Emoji" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                   Visibility="{Binding ShowEmoji, Converter={StaticResource BoolToVis}}" />
                                                                        <TextBlock Text="{Binding IconText}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                   Visibility="{Binding ShowText, Converter={StaticResource BoolToVis}}" />
                                                                    </Grid>
                                                                </Border>
                                                                <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Label}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>
                                                                <TextBlock Grid.Column="2" Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center"
                                                                           Foreground="{DynamicResource PositiveBrush}" Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}" />
                                                            </Grid>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </StackPanel>
                                </Border>
                            </Popup>
                </StackPanel>
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,26,0,0" c:Anim.Enter="True" c:Anim.Delay="60">
                <Button Style="{StaticResource Button.Primary}" Command="{Binding SendCommand}" Padding="20,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE724;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" />
                        <TextBlock Text="{c:Tr 'Send'}" Margin="9,0,0,0" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Button.Outline}" Command="{Binding ReceiveCommand}" Padding="20,10" Margin="8,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" />
                        <TextBlock Text="{c:Tr 'Receive'}" Margin="9,0,0,0" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Button.Outline}" Command="{Binding TradeCommand}" Padding="20,10" Margin="8,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8AB;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" />
                        <TextBlock Text="{c:Tr 'Trade'}" Margin="9,0,0,0" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <Grid Margin="0,28,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="330" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <ItemsControl Grid.Row="0" Grid.ColumnSpan="3" ItemsSource="{Binding Overview}" Focusable="False" Visibility="{Binding HasOverview, Converter={StaticResource BoolToVis}}"
                              c:Anim.Enter="True" c:Anim.Delay="80">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="{Binding Label}" Style="{StaticResource Text.Label}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Value}" FontSize="14" FontWeight="SemiBold" Margin="0,3,0,0" TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsUp}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource PositiveBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsDown}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource NegativeBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource Card}" Margin="0,18,0,0" Padding="26,20,26,16" c:Anim.Enter="True" c:Anim.Delay="100">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="112" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{c:Tr 'News'}" Style="{StaticResource Text.Subtitle}" />
                                <TextBlock Text="{Binding NewsCounter}" Style="{StaticResource Text.Label}" FontSize="12" Margin="10,1,0,0"
                                           Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,-6,-8,-6"
                                        Visibility="{Binding HasManyNews, Converter={StaticResource BoolToVis}}">
                                <Button Style="{StaticResource Button.Icon}" Content="&#xE76B;" Width="30" Height="30" FontSize="11"
                                        Command="{Binding PreviousNewsCommand}" ToolTip="{c:Tr 'Previous'}" />
                                <Button Style="{StaticResource Button.Icon}" Content="&#xE76C;" Width="30" Height="30" FontSize="11"
                                        Command="{Binding NextNewsCommand}" ToolTip="{c:Tr 'Next'}" />
                            </StackPanel>
                        </Grid>

                        <ItemsControl Grid.Row="1" ItemsSource="{Binding VisibleNews}" Focusable="False" Margin="0,14,0,0"
                                      Visibility="{Binding HasNews, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel c:Anim.Enter="True" c:Anim.Offset="8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid Width="26" Height="26">
                                                <Border CornerRadius="13" Background="{DynamicResource SurfacePressedBrush}"
                                                        Visibility="{Binding AvatarName, Converter={StaticResource ResourceMissingToVis}}">
                                                    <TextBlock Text="{Binding AuthorInitial}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <Ellipse>
                                                    <Ellipse.Fill>
                                                        <ImageBrush ImageSource="{Binding AvatarName, Converter={StaticResource ResourceImage}}" Stretch="UniformToFill" />
                                                    </Ellipse.Fill>
                                                </Ellipse>
                                            </Grid>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Author}" FontSize="12.5" FontWeight="SemiBold" />
                                                <TextBlock Text="  ·  " FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}"
                                                           Visibility="{Binding HasDate, Converter={StaticResource BoolToVis}}" />
                                                <TextBlock Text="{Binding Date}" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}"
                                                           Visibility="{Binding HasDate, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Subtitle}" FontSize="15" Margin="0,12,0,0"
                                                   TextTrimming="CharacterEllipsis" Visibility="{Binding HasTitle, Converter={StaticResource BoolToVis}}" />
                                        <ScrollViewer MaxHeight="66" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                            <TextBlock Text="{Binding Description}" FontSize="13.5" LineHeight="20" TextWrapping="Wrap" Margin="0,0,6,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </ScrollViewer>
                                        <Button Style="{StaticResource Button.Link}" Margin="0,8,0,0" HorizontalAlignment="Left"
                                                Command="{Binding DataContext.OpenNewsCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" Visibility="{Binding HasUrl, Converter={StaticResource BoolToVis}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{c:Tr 'Attached link'}" />
                                                <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource IconFont}" FontSize="10" Margin="6,1,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Control Grid.Row="1" Style="{StaticResource Spinner}" Width="18" Height="18"
                                 Visibility="{Binding IsNewsLoading, Converter={StaticResource BoolToVis}}" />
                        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding ShowNewsEmpty, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{c:Tr 'No news right now'}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" />
                            <Button Style="{StaticResource Button.Link}" Content="{c:Tr 'Try again'}" FontSize="12" HorizontalAlignment="Center" Margin="0,6,0,0"
                                    Command="{Binding RefreshNewsCommand}" />
                        </StackPanel>

                        <ItemsControl Grid.Row="2" ItemsSource="{Binding NewsDots}" Focusable="False" HorizontalAlignment="Center" Margin="0,12,0,0"
                                      Visibility="{Binding HasManyNews, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource Dot}" CommandParameter="{Binding}"
                                            Command="{Binding DataContext.GoToNewsCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

            <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource Card}" Margin="0,18,0,0" Padding="22,18,22,14" c:Anim.Enter="True" c:Anim.Delay="140">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="140" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="{c:Tr 'Portfolio'}" Style="{StaticResource Text.Subtitle}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding PortfolioChangeText}" Tag="{Binding PortfolioIsUp}" Style="{StaticResource Text.Change}" FontSize="12.5"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Text="{Binding PortfolioDaysText}" Style="{StaticResource Text.Label}" FontSize="12" Margin="0,2,0,0"
                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                    </StackPanel>
                    <c:LineChart Grid.Row="1" Margin="0,6,0,0" Points="{Binding PortfolioPoints}" Currency="{Binding Currency}"
                                 LabelBrush="{DynamicResource TextTertiaryBrush}" TooltipBackground="{DynamicResource ToastBrush}"
                                 TooltipForeground="{DynamicResource OnToastBrush}"
                                 Visibility="{Binding HasPortfolioHistory, Converter={StaticResource BoolToVis}}">
                        <c:LineChart.Style>
                            <Style TargetType="c:LineChart">
                                <Setter Property="Stroke" Value="{DynamicResource PositiveBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PortfolioIsUp}" Value="False">
                                        <Setter Property="Stroke" Value="{DynamicResource NegativeBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </c:LineChart.Style>
                    </c:LineChart>
                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding HasPortfolioHistory, Converter={StaticResource BoolToVisInverse}}">
                        <TextBlock Text="&#xE9D2;" FontFamily="{StaticResource IconFont}" FontSize="20" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                        <TextBlock Text="{c:Tr 'Your total is saved once a day'}" Style="{StaticResource Text.Caption}" Margin="0,8,0,0" HorizontalAlignment="Center" />
                        <TextBlock Text="{c:Tr 'Come back tomorrow to see the chart'}" Style="{StaticResource Text.Label}" FontSize="11.5"
                                   Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

                <Border Grid.Row="2" Grid.RowSpan="4" Grid.Column="0" Style="{StaticResource Card}" Margin="0,18,0,0" Padding="12,18,12,10" MinHeight="260" c:Anim.Enter="True" c:Anim.Delay="200">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Margin="10,0,10,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{c:Tr 'Coins'}" Style="{StaticResource Text.Subtitle}" />
                                <TextBlock Text="{Binding CoinsCountText}" Style="{StaticResource Text.Label}" FontSize="12" Margin="10,1,0,0"
                                           Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0,10,16"
                                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                            <Border Width="52" Height="52" CornerRadius="26" Background="{DynamicResource SurfaceAltBrush}" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="19" Foreground="{DynamicResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{c:Tr 'No funds yet'}" Style="{StaticResource Text.Subtitle}" HorizontalAlignment="Center" Margin="0,14,0,0" />
                            <TextBlock Text="{c:Tr 'Pick a coin and a network in Receive to get your address'}" Style="{StaticResource Text.Caption}"
                                       HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="260" Margin="0,4,0,0" />
                            <Button Style="{StaticResource Button.Primary}" Command="{Binding ReceiveCommand}" HorizontalAlignment="Center"
                                    Margin="0,16,0,0" Padding="18,9">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Text="{c:Tr 'Receive'}" Margin="8,0,0,0" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <ItemsControl Grid.Row="1" ItemsSource="{Binding VisibleAssets}" Focusable="False" VerticalAlignment="Top">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ContentControl Style="{StaticResource HoverRow}" c:Anim.Stagger="True" c:Anim.Enter="True" c:Anim.Offset="6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <c:CoinIcon Source="{Binding IconPath}" Initial="{Binding Initial}" Size="34" />
                                            <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}" FontSize="13.5" TextTrimming="CharacterEllipsis" />
                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                    <TextBlock Text="{Binding Symbol}" Style="{StaticResource Text.Label}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                    <Border Style="{StaticResource Chip.Static}" Padding="6,0">
                                                        <TextBlock Text="{Binding Network}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" />
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding PriceText}" HorizontalAlignment="Right" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                <TextBlock Text="{Binding ChangeText}" Tag="{Binding IsUp}" Style="{StaticResource Text.Change}"
                                                           FontSize="12" HorizontalAlignment="Right" Margin="0,2,0,0"
                                                           Visibility="{Binding HasChange, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding FiatText}" FontSize="13.5" HorizontalAlignment="Right" />
                                                <TextBlock Text="{Binding BalanceText}" Style="{StaticResource Text.Label}" FontSize="12" HorizontalAlignment="Right" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <Button Grid.Column="4" Style="{StaticResource Button.Icon}" Content="&#xE724;" Margin="12,0,0,0" FontSize="12"
                                                    Width="30" Height="30" ToolTip="{c:Tr 'Send'}"
                                                    Command="{Binding DataContext.SendCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Grid.Column="5" Style="{StaticResource Button.Icon}" Content="&#xE81C;" Margin="6,0,0,0" FontSize="12"
                                                    Width="30" Height="30" ToolTip="{c:Tr 'Transaction history'}"
                                                    Command="{Binding DataContext.HistoryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </ContentControl>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Grid.Row="2" Style="{StaticResource Button.Secondary}" Command="{Binding ToggleCoinsCommand}" Content="{Binding CoinsToggleText}"
                                HorizontalAlignment="Stretch" Margin="10,10,10,6" Padding="14,9" FontSize="12.5"
                                Visibility="{Binding HasMoreCoins, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </Border>

                <Border Grid.Row="3" Grid.Column="2" Style="{StaticResource Card}" Margin="0,18,0,0" Padding="22,18" c:Anim.Enter="True" c:Anim.Delay="240">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{c:Tr 'Allocation'}" Style="{StaticResource Text.Subtitle}" />
                        <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,16,0,0" Visibility="{Binding HasFunds, Converter={StaticResource BoolToVis}}">
                            <c:DonutChart Width="128" Height="128" Slices="{Binding Slices}" Thickness="11" TrackBrush="{DynamicResource SurfaceAltBrush}" />
                            <ItemsControl ItemsSource="{Binding Slices}" Margin="0,20,0,0" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="7" Height="7" Fill="{Binding Color, Converter={StaticResource HexToBrush}}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding Label}" Margin="9,0,0,0" FontSize="12.5" />
                                            <TextBlock Grid.Column="2" Text="{Binding PercentText}" Style="{StaticResource Text.Label}" FontSize="12" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,0,0,16" Visibility="{Binding HasFunds, Converter={StaticResource BoolToVisInverse}}">
                            <Grid Width="128" Height="128">
                                <Ellipse Stroke="{DynamicResource SurfaceAltBrush}" StrokeThickness="11" />
                                <TextBlock Text="0%" Style="{StaticResource Text.Label}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Text="{c:Tr 'Your split by coin shows up here'}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center"
                                       TextAlignment="Center" Margin="0,14,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="4" Grid.Column="2" Style="{StaticResource Card}" Margin="0,18,0,0" Padding="22,18" c:Anim.Enter="True" c:Anim.Delay="280">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{c:Tr 'Fear and greed'}" Style="{StaticResource Text.Subtitle}" />
                        <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,10,0,0"
                                    Visibility="{Binding HasFearGreed, Converter={StaticResource BoolToVis}}">
                            <c:FearGreedGauge Height="88" Width="176" Value="{Binding FearGreedValue}" NeedleBrush="{DynamicResource TextBrush}" />
                            <TextBlock Text="{Binding FearGreedNumber}" Style="{StaticResource Text.Title}" HorizontalAlignment="Center" Margin="0,8,0,0" />
                            <TextBlock Text="{Binding FearGreedLabel}" Style="{StaticResource Text.Label}" HorizontalAlignment="Center" />
                            <Button Style="{StaticResource Button.Link}" Command="{Binding OpenAlternativeCommand}" FontSize="11" HorizontalAlignment="Center"
                                    Margin="0,8,0,0" ToolTip="{c:Tr 'Source of the index'}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="alternative.me" />
                                    <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource IconFont}" FontSize="9" Margin="5,1,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <Control Grid.Row="1" Style="{StaticResource Spinner}" Width="18" Height="18"
                                 Visibility="{Binding HasFearGreed, Converter={StaticResource BoolToVisInverse}}" />
                    </Grid>
                </Border>

            <Border Grid.Row="5" Grid.Column="2" Style="{StaticResource Card}" Margin="0,18,0,0" Padding="22,18" c:Anim.Enter="True" c:Anim.Delay="320" VerticalAlignment="Top"
                    Visibility="{Binding HasMovers, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock Text="{c:Tr 'Top movers'}" Style="{StaticResource Text.Subtitle}" />
                        <TextBlock Text="{c:Tr '24h'}" Style="{StaticResource Text.Label}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                    </Grid>
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Movers}" Focusable="False" Margin="0,10,0,0"
                                  Visibility="{Binding HasMovers, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="64" />
                                    </Grid.ColumnDefinitions>
                                    <c:CoinIcon Source="{Binding IconPath}" Initial="{Binding Initial}" Size="24" />
                                    <TextBlock Grid.Column="1" Text="{Binding Symbol}" FontSize="13" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding PriceText}" Style="{StaticResource Text.Label}" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0" />
                                    <TextBlock Grid.Column="3" Text="{Binding ChangeText}" Tag="{Binding IsUp}" Style="{StaticResource Text.Change}" FontSize="12.5"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Control Grid.Row="1" Style="{StaticResource Spinner}" Width="18" Height="18"
                             Visibility="{Binding HasMovers, Converter={StaticResource BoolToVisInverse}}" />
                </Grid>
            </Border>


            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
