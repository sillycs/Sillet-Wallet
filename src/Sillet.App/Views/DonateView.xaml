<UserControl x:Class="Sillet.App.Views.DonateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Sillet.App.Controls">
    <Grid Margin="0,10,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource Card}" Padding="28,22" c:Anim.Enter="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid Width="64" Height="64" VerticalAlignment="Center">
                    <Ellipse Fill="{DynamicResource NegativeSoftBrush}" />
                    <TextBlock Text="&#xEB52;" FontFamily="{StaticResource IconFont}" FontSize="26" Foreground="{DynamicResource NegativeBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                        <TextBlock.RenderTransform>
                            <ScaleTransform />
                        </TextBlock.RenderTransform>
                        <TextBlock.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)">
                                            <EasingDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.15" Value="1.15" />
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="1" />
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.45" Value="1.1" />
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.65" Value="1" />
                                            <EasingDoubleKeyFrame KeyTime="0:0:2.2" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)">
                                            <EasingDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.15" Value="1.15" />
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="1" />
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.45" Value="1.1" />
                                            <EasingDoubleKeyFrame KeyTime="0:0:0.65" Value="1" />
                                            <EasingDoubleKeyFrame KeyTime="0:0:2.2" Value="1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </TextBlock.Triggers>
                    </TextBlock>
                </Grid>
                <StackPanel Grid.Column="1" Margin="22,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{c:Tr 'Support Sillet'}" Style="{StaticResource Text.Title}" FontSize="22" />
                    <TextBlock Text="{c:Tr 'Sillet is free, safe and has no ads. Donations help us keep updating and improving it'}" Style="{StaticResource Text.Label}"
                               TextWrapping="Wrap" Margin="0,6,0,12" LineHeight="19" />
                    <WrapPanel>
                        <Border Style="{StaticResource Chip.Static}" Padding="10,4" Margin="0,0,8,0"><TextBlock Text="{c:Tr 'Free forever'}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" /></Border>
                        <Border Style="{StaticResource Chip.Static}" Padding="10,4" Margin="0,0,8,0"><TextBlock Text="{c:Tr 'No ads'}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" /></Border>
                        <Border Style="{StaticResource Chip.Static}" Padding="10,4" Margin="0,0,8,0"><TextBlock Text="{c:Tr 'No tracking'}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" /></Border>
                        <Border Style="{StaticResource Chip.Static}" Padding="10,4" Margin="0,0,8,0"><TextBlock Text="{c:Tr 'Open source soon'}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" /></Border>
                    </WrapPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="18,18,18,14" c:Anim.Enter="True" c:Anim.Delay="60">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{c:Tr 'Pick a coin'}" Style="{StaticResource Text.Subtitle}" Margin="2,0,0,12" />
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False" Margin="-8,0">
                    <ItemsControl ItemsSource="{Binding Options}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                                        Cursor="Hand" FocusVisualStyle="{x:Null}" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4"
                                        c:Anim.Stagger="True" c:Anim.Enter="True" c:Anim.Offset="6">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="11" Padding="10,9">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                                                </Trigger>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <c:CoinIcon Source="{Binding IconPath}" Initial="{Binding Initial}" Size="30" />
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="13.5" />
                                            <TextBlock Text="{Binding ShortAddress}" Style="{StaticResource Text.Label}" FontFamily="{StaticResource MonoFont}" FontSize="11.5" />
                                        </StackPanel>
                                        <Border Grid.Column="2" Style="{StaticResource Chip.Static}" Padding="7,1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Symbol}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" />
                                        </Border>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Grid.Row="2" Text="{c:Tr 'Any amount helps, thx :3'}" Style="{StaticResource Text.Label}" FontSize="11.5"
                               Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Center" Margin="0,10,0,0" />
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="28,22" c:Anim.Enter="True" c:Anim.Delay="120">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <c:CoinIcon Source="{Binding Selected.IconPath}" Initial="{Binding Selected.Initial}" Size="36" />
                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource Text.Title}" FontSize="19" />
                                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Text.Label}" />
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Text="{c:Tr 'Amount'}" Style="{StaticResource Text.Label}" Margin="0,22,0,8" />
                            <ItemsControl ItemsSource="{Binding Amounts}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="4" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Margin="0,0,8,0" Padding="0,10" FontSize="13" Content="{Binding Label}"
                                                Command="{Binding DataContext.SelectAmountCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                                                            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid Margin="2,8,0,0">
                                <TextBlock Text="{Binding AmountHint}" Style="{StaticResource Text.Label}" FontSize="12" Visibility="{Binding HasAmountHint, Converter={StaticResource BoolToVis}}" />
                                <TextBlock Text="{Binding BalanceText}" Style="{StaticResource Text.Label}" FontSize="12" HorizontalAlignment="Right"
                                           Foreground="{DynamicResource TextTertiaryBrush}" />
                            </Grid>

                            <Button Style="{StaticResource Button.Primary}" Command="{Binding SendCommand}" Padding="16,12" Margin="0,16,0,0"
                                    IsEnabled="{Binding CanSendFromWallet}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xEB52;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding SendText}" Margin="8,0,0,0" />
                                </StackPanel>
                            </Button>
                            <TextBlock Text="{Binding SendHint}" Style="{StaticResource Text.Label}" FontSize="12" Margin="2,8,0,0" TextWrapping="Wrap"
                                       Visibility="{Binding IsWatchOnly, Converter={StaticResource BoolToVis}}" />

                            <TextBlock Text="{c:Tr 'Or send from any wallet'}" Style="{StaticResource Text.Label}" Margin="0,22,0,8" />
                            <Grid>
                                <Border Style="{StaticResource Card.Soft}" Padding="14,12,44,12">
                                    <TextBlock Text="{Binding Address}" Style="{StaticResource Text.Mono}" FontSize="12.5" />
                                </Border>
                                <Button Command="{Binding CopyCommand}" Width="32" Height="32" FontSize="12" HorizontalAlignment="Right" Margin="0,0,6,0" ToolTip="{c:Tr 'Copy address'}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource Button.Icon}">
                                            <Setter Property="Content" Value="&#xE8C8;" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Copied}" Value="True">
                                                    <Setter Property="Content" Value="&#xE73E;" />
                                                    <Setter Property="Foreground" Value="{DynamicResource PositiveBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                            <TextBlock Text="{Binding WarningText}" Style="{StaticResource Text.Label}" FontSize="12" Margin="2,10,0,0"
                                       Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" VerticalAlignment="Top">
                            <Border Background="#F4F4F5" CornerRadius="16" Padding="14">
                                <Image Source="{Binding Address, Converter={StaticResource QrCode}}" Width="200" Height="200"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor" />
                            </Border>
                            <TextBlock Text="{c:Tr 'Scan with any wallet'}" Style="{StaticResource Text.Label}" FontSize="11.5" HorizontalAlignment="Center" Margin="0,10,0,0"
                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
