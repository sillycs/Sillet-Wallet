<UserControl x:Class="Sillet.App.Views.UnlockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Sillet.App.Controls"
             Loaded="OnLoaded">
    <StackPanel Width="320" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,70">
        <TextBlock Text="sillet" Style="{StaticResource Text.Wordmark}" FontSize="44" HorizontalAlignment="Center"
                   c:Anim.Enter="True" c:Anim.Offset="14" />

        <StackPanel Margin="0,32,0,0" c:Anim.Enter="True" c:Anim.Delay="60">
            <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile, Mode=TwoWay}" Style="{StaticResource Select}" Margin="0,0,0,8"
                      Visibility="{Binding HasManyProfiles, Converter={StaticResource BoolToVis}}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="22" Height="22" CornerRadius="7" Background="{DynamicResource SurfacePressedBrush}">
                                <TextBlock Text="{Binding Initial}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{Binding Name}" Margin="10,0,0,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding KindText}" Style="{StaticResource Text.Label}" FontSize="11.5" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>

        <StackPanel Margin="0,8,0,0" c:Anim.Enter="True" c:Anim.Delay="100" Visibility="{Binding IsWatch, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding ProfileName}" Style="{StaticResource Text.Subtitle}" HorizontalAlignment="Center" />
            <TextBlock Text="{c:Tr 'Watch-only. Balances and receive addresses, no keys on this computer'}" Style="{StaticResource Text.Label}" FontSize="12"
                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,0" />
            <Button Style="{StaticResource Button.Primary}" Content="{c:Tr 'Open'}" Command="{Binding OpenWatchCommand}" Margin="0,16,0,0" Padding="18,12" />
            <TextBlock Text="{Binding Error}" Foreground="{DynamicResource NegativeBrush}" FontSize="12" Margin="2,8,0,0"
                       Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
        </StackPanel>

        <StackPanel Margin="0,8,0,0" c:Anim.Enter="True" c:Anim.Delay="100" Visibility="{Binding IsSeed, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{c:Tr 'Password'}" Style="{StaticResource Text.Label}" Margin="2,0,0,8" />
            <PasswordBox x:Name="PasswordInput" Style="{StaticResource Password}" c:Field.Holder="{c:Tr 'Password'}" PasswordChanged="Password_Changed" KeyDown="Password_KeyDown" />
            <TextBlock Text="{Binding Error}" Foreground="{DynamicResource NegativeBrush}" FontSize="12" Margin="2,8,0,0"
                       Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />

            <Button Style="{StaticResource Button.Primary}" Command="{Binding UnlockCommand}" Margin="0,12,0,0" Padding="18,12">
                <StackPanel Orientation="Horizontal">
                    <Control Style="{StaticResource Spinner}" Foreground="{DynamicResource OnAccentBrush}" Width="14" Height="14" Margin="0,0,10,0"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{c:Tr 'Unlock'}" />
                </StackPanel>
            </Button>

            <Button Style="{StaticResource Button.Secondary}" Command="{Binding HelloCommand}" Margin="0,8,0,0" Padding="18,11" HorizontalAlignment="Stretch"
                    Visibility="{Binding HasPasskey, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE928;" FontFamily="{StaticResource IconFont}" FontSize="14" VerticalAlignment="Center" />
                    <TextBlock Text="{c:Tr 'Unlock with Windows Hello'}" Margin="10,0,0,0" />
                </StackPanel>
            </Button>

            <Button Style="{StaticResource Button.Link}" Content="{c:Tr 'Restore with recovery phrase'}" Command="{Binding ForgotCommand}"
                    HorizontalAlignment="Center" Margin="0,18,0,0" />
            <TextBlock Text="{Binding LastOpenedText}" Style="{StaticResource Text.Label}" FontSize="11.5" HorizontalAlignment="Center" Margin="0,14,0,0"
                       Foreground="{DynamicResource TextTertiaryBrush}" Visibility="{Binding HasLastOpened, Converter={StaticResource BoolToVis}}" />
        </StackPanel>
    </StackPanel>
</UserControl>
