<Window x:Class="Sillet.App.Views.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Sillet.App.Controls"
        Title="Sillet" Icon="../Assets/silleticon.ico" Width="420" Height="210" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True" Topmost="True"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="14">
    <Grid Margin="28,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="TitleText" Style="{StaticResource Text.Title}" />
        <TextBlock x:Name="StatusText" Grid.Row="1" Style="{StaticResource Text.Label}" Margin="0,6,0,0" TextWrapping="Wrap" />
        <ProgressBar x:Name="Bar" Grid.Row="2" Height="6" Minimum="0" Maximum="1" Margin="0,18,0,0" />
        <Button x:Name="CloseButton" Grid.Row="4" Style="{StaticResource Button.Secondary}" HorizontalAlignment="Right" Padding="16,6"
                Visibility="Collapsed" Click="OnClose" />
    </Grid>
</Window>
