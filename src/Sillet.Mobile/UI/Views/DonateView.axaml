<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:Sillet.Mobile.UI"
             x:Class="Sillet.Mobile.UI.Views.DonateView">
    <ScrollViewer>
        <StackPanel Margin="16,4,16,24" Spacing="12">
            <Border Classes="card" Padding="20">
                <StackPanel Spacing="8" HorizontalAlignment="Center">
                    <Border Width="56" Height="56" CornerRadius="28" Background="{DynamicResource NegativeSoftBrush}" HorizontalAlignment="Center">
                        <Path Classes="icon" Data="{StaticResource IconHeart}" Stroke="{DynamicResource NegativeBrush}" Fill="{DynamicResource NegativeBrush}" />
                    </Border>
                    <TextBlock Text="{ui:Tr 'Support Sillet'}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" />
                    <TextBlock Text="{ui:Tr 'Sillet is free, safe and has no ads. Donations help us keep updating and improving it'}" Classes="label"
                               TextWrapping="Wrap" TextAlignment="Center" />
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Options}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="5" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Classes="row" Margin="3" Command="{Binding $parent[ItemsControl].DataContext.SelectCommand}" CommandParameter="{Binding}">
                            <Border CornerRadius="14" Padding="6,10" Background="{DynamicResource SurfaceBrush}" BorderThickness="1.5"
                                    Classes="opt" Classes.selected="{Binding IsSelected}">
                                <StackPanel Spacing="4" HorizontalAlignment="Center">
                                    <Grid Width="26" Height="26" HorizontalAlignment="Center">
                                        <Border CornerRadius="13" Background="{DynamicResource SurfacePressedBrush}">
                                            <TextBlock Text="{Binding Initial}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <Image Source="{Binding IconPath, Converter={StaticResource FileImage}}" />
                                    </Grid>
                                    <TextBlock Text="{Binding Symbol}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Classes="card" Padding="18">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="2" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding Subtitle}" Classes="label" HorizontalAlignment="Center" />
                    </StackPanel>
                    <Border Background="#FFFFFF" CornerRadius="18" Padding="12" HorizontalAlignment="Center">
                        <Image Width="180" Height="180" Source="{Binding Address, Converter={StaticResource Qr}}" RenderOptions.BitmapInterpolationMode="None" />
                    </Border>
                    <Border Classes="soft">
                        <SelectableTextBlock Text="{Binding Address}" FontFamily="monospace" FontSize="12.5" TextWrapping="Wrap" TextAlignment="Center" />
                    </Border>
                    <Grid ColumnDefinitions="*,10,*">
                        <Button Classes="secondary" Command="{Binding CopyCommand}" HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                <Path Classes="icon small" Data="{StaticResource IconCopy}" />
                                <TextBlock Text="{ui:Tr 'Copy'}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" Classes="secondary" HorizontalAlignment="Stretch" Click="Share_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                <Path Classes="icon small" Data="{StaticResource IconShare}" />
                                <TextBlock Text="{ui:Tr 'Share'}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <TextBlock Text="{Binding WarningText}" Foreground="{DynamicResource WarningBrush}" FontSize="12.5" TextWrapping="Wrap" TextAlignment="Center" />
                </StackPanel>
            </Border>

            <StackPanel Spacing="8" IsVisible="{Binding CanSendFromWallet}">
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="4,10,0,0">
                    <Path Classes="icon small" Data="{StaticResource IconHeart}" Stroke="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{ui:Tr 'Donate from Sillet'}" Classes="section" Margin="0" VerticalAlignment="Center" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Amounts}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Classes="row" Margin="3" Command="{Binding $parent[ItemsControl].DataContext.SelectAmountCommand}" CommandParameter="{Binding}">
                                <Border CornerRadius="12" Padding="4,10" Background="{DynamicResource SurfaceAltBrush}" BorderThickness="1.5"
                                        Classes="opt" Classes.selected="{Binding IsSelected}">
                                    <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding AmountHint}" Classes="caption" IsVisible="{Binding HasAmountHint}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding BalanceText}" Classes="caption" />
                <Button Classes="primary" Content="{Binding SendText}" Command="{Binding SendCommand}" HorizontalAlignment="Stretch" />
            </StackPanel>
            <TextBlock Text="{Binding SendHint}" Classes="caption" TextWrapping="Wrap" TextAlignment="Center" IsVisible="{Binding IsWatchOnly}" />
            <TextBlock Text="{ui:Tr 'Any amount helps, thx :3'}" Classes="caption" HorizontalAlignment="Center" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
