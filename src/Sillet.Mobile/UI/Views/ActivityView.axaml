<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:Sillet.Mobile.UI"
             x:Class="Sillet.Mobile.UI.Views.ActivityView">
  <Grid>
    <Grid RowDefinitions="Auto,Auto,*" Margin="16,4,16,0">
            <StackPanel Spacing="2" Margin="4,4,0,10">
                <TextBlock Text="{ui:Tr 'Activity'}" Classes="title" />
                <TextBlock Text="{Binding CountText}" Classes="label" />
                <Border Classes="chip" HorizontalAlignment="Left" Margin="0,6,0,0" IsVisible="{Binding HasAssetFilter}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{Binding AssetFilterText}" FontSize="12" VerticalAlignment="Center" />
                        <Button Classes="ghost" Padding="4" Command="{Binding ClearAssetFilterCommand}">
                            <Path Classes="icon small" Data="{StaticResource IconClose}" Stroke="{DynamicResource TextSecondaryBrush}" />
                        </Button>
                    </StackPanel>
                </Border>
                <Border Classes="seghost" Margin="0,8,0,0" IsVisible="{Binding HasItems}">
                    <UniformGrid Columns="3">
                        <RadioButton Classes="seg" GroupName="ActivityFilter" Content="{ui:Tr 'All'}" IsChecked="{Binding FilterAll, Mode=TwoWay}" />
                        <RadioButton Classes="seg" GroupName="ActivityFilter" Content="{ui:Tr 'Sent'}" IsChecked="{Binding FilterSent, Mode=TwoWay}" />
                        <RadioButton Classes="seg" GroupName="ActivityFilter" Content="{ui:Tr 'Received'}" IsChecked="{Binding FilterReceived, Mode=TwoWay}" />
                    </UniformGrid>
                </Border>
                <TextBlock Text="{ui:Tr 'Nothing matches this filter'}" Classes="label" Margin="4,10,0,0" IsVisible="{Binding ShowNoMatches}" />
            </StackPanel>
            <Border Grid.Row="1" Classes="card" IsVisible="{Binding IsEmpty}" Padding="22">
                <StackPanel Spacing="8" HorizontalAlignment="Center">
                    <Path Classes="icon" Data="{StaticResource IconActivity}" Stroke="{DynamicResource TextTertiaryBrush}" />
                    <TextBlock Text="{ui:Tr 'No transfers yet'}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="{ui:Tr 'Transfers you send or receive show up here'}" Classes="label" TextWrapping="Wrap" TextAlignment="Center" />
                </StackPanel>
            </Border>
            <ItemsControl Grid.Row="2" ItemsSource="{Binding Items}">
                <ItemsControl.Template>
                    <ControlTemplate>
                        <ScrollViewer>
                            <ItemsPresenter ItemsPanel="{TemplateBinding ItemsPanel}" Margin="0,0,0,24" />
                        </ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Classes="row" Margin="0,0,0,8" Command="{Binding $parent[ItemsControl].DataContext.OpenReceiptCommand}" CommandParameter="{Binding}">
                            <Border Classes="card" Padding="14,12">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Grid Width="38" Height="38">
                                        <Border CornerRadius="19" Background="{DynamicResource SurfacePressedBrush}">
                                            <TextBlock Text="{Binding Initial}" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <Image Source="{Binding IconPath, Converter={StaticResource FileImage}}" />
                                        <Border Width="16" Height="16" CornerRadius="8" Background="{DynamicResource SurfaceBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-3,-3">
                                            <Panel>
                                                <Path Classes="icon" Data="{StaticResource IconSend}" StrokeThickness="2.4" RenderTransform="scale(0.5)" Stroke="{DynamicResource TextSecondaryBrush}" IsVisible="{Binding !IsIncoming}" />
                                                <Path Classes="icon" Data="{StaticResource IconReceive}" StrokeThickness="2.4" RenderTransform="scale(0.5)" Stroke="{DynamicResource PositiveBrush}" IsVisible="{Binding IsIncoming}" />
                                            </Panel>
                                        </Border>
                                    </Grid>
                                    <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center" Spacing="1">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding ToText}" Classes="caption" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding DateText}" Classes="caption" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding AmountText}" FontWeight="SemiBold" HorizontalAlignment="Right" Classes.up="{Binding IsIncoming}" />
                                        <Border Classes="chip" HorizontalAlignment="Right" Margin="0,3,0,0">
                                            <TextBlock Text="{Binding Network}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
    </Grid>
    <Border Background="{DynamicResource BgBrush}" IsVisible="{Binding IsReceiptOpen}">
        <ScrollViewer>
            <StackPanel Margin="16,4,16,28" Spacing="12">
                <Grid ColumnDefinitions="Auto,*" Margin="0,2,0,2">
                    <Button Classes="ghost" Width="42" Height="42" Padding="0" Command="{Binding CloseReceiptCommand}">
                        <Path Classes="icon" Data="{StaticResource IconBack}" Stroke="{DynamicResource TextBrush}" StrokeThickness="2" />
                    </Button>
                    <TextBlock Grid.Column="1" Text="{ui:Tr 'Receipt'}" Classes="title" VerticalAlignment="Center" Margin="6,0,0,0" />
                </Grid>
                <Border Classes="card" Padding="0" ClipToBounds="True">
                    <StackPanel>
                        <Border Padding="20,24,20,20" Background="{DynamicResource SurfaceAltBrush}">
                            <StackPanel Spacing="6" HorizontalAlignment="Center">
                                <Border Width="52" Height="52" CornerRadius="26" Background="{DynamicResource SurfaceBrush}" HorizontalAlignment="Center">
                                    <Panel>
                                        <Path Classes="icon" Data="{StaticResource IconCheck}" Stroke="{DynamicResource PositiveBrush}" StrokeThickness="2.6" RenderTransform="scale(1.3)" IsVisible="{Binding ReceiptIncoming}" />
                                        <Path Classes="icon" Data="{StaticResource IconSend}" Stroke="{DynamicResource TextBrush}" StrokeThickness="2" RenderTransform="scale(1.1)" IsVisible="{Binding !ReceiptIncoming}" />
                                    </Panel>
                                </Border>
                                <TextBlock Text="{Binding ReceiptStatusText}" Classes="label" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding ReceiptAmountText}" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Classes.up="{Binding ReceiptIncoming}" />
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                    <Border Classes="chip"><TextBlock Text="{Binding ReceiptNetworkText}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" /></Border>
                                    <TextBlock Text="{Binding ReceiptDateText}" Classes="caption" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Height="1" Background="{DynamicResource BorderStrongBrush}" Opacity="0.5" Margin="18,0" />
                        <ItemsControl ItemsSource="{Binding ReceiptRows}" Margin="18,6,18,10">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,9">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{Binding Label}" Classes="caption" />
                                            <SelectableTextBlock Text="{Binding Value}" TextWrapping="Wrap" FontSize="14" IsVisible="{Binding !Mono}" FontWeight="Normal" />
                                            <SelectableTextBlock Text="{Binding Value}" TextWrapping="Wrap" FontFamily="monospace" FontSize="12" IsVisible="{Binding Mono}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Classes="ghost" Width="38" Height="38" Padding="0" VerticalAlignment="Top" IsVisible="{Binding Trackable}"
                                                Command="{Binding $parent[ItemsControl].DataContext.TrackPaymentCommand}">
                                            <Path Classes="icon" Data="{StaticResource IconEye}" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.8" RenderTransform="scale(0.8)" />
                                        </Button>
                                        <Button Grid.Column="1" Classes="ghost" Width="38" Height="38" Padding="0" VerticalAlignment="Top" IsVisible="{Binding Copyable}"
                                                Command="{Binding $parent[ItemsControl].DataContext.CopyRowCommand}" CommandParameter="{Binding}">
                                            <Path Classes="icon" Data="{StaticResource IconCopy}" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.8" RenderTransform="scale(0.8)" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <StackPanel Spacing="6">
                    <TextBlock Text="{ui:Tr 'Receipt language'}" Classes="caption" Margin="4,0,0,0" />
                    <ItemsControl ItemsSource="{Binding ReceiptLanguages}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Classes="secondary" Classes.primary="{Binding IsSelected}" Content="{Binding Name}" Margin="2,0" Padding="4,10" FontSize="12"
                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                        Command="{Binding $parent[ItemsControl].DataContext.SetReceiptLanguageCommand}" CommandParameter="{Binding Code}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <Button Classes="primary" Content="{ui:Tr 'Speed up'}" Command="{Binding SpeedUpCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" IsVisible="{Binding ReceiptCanSpeedUp}" />
                <Button Classes="secondary" Content="{ui:Tr 'Cancel payment'}" Command="{Binding CancelPaymentCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" IsVisible="{Binding ReceiptCanSpeedUp}" />
                <Button Classes="primary" Content="{ui:Tr 'Send again'}" Command="{Binding RetryCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" IsVisible="{Binding ReceiptCanRetry}" />
                <Button Classes="secondary" Command="{Binding TrackPaymentCommand}" HorizontalAlignment="Stretch" IsVisible="{Binding ReceiptCanTrack}">
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                        <Path Classes="icon" Data="{StaticResource IconEye}" StrokeThickness="2" />
                        <TextBlock Text="{ui:Tr 'Follow this payment'}" />
                    </StackPanel>
                </Button>
                <Button Classes="primary" Command="{Binding DownloadReceiptCommand}" HorizontalAlignment="Stretch">
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                        <Path Classes="icon" Data="{StaticResource IconShare}" StrokeThickness="2" />
                        <TextBlock Text="{ui:Tr 'Download receipt'}" />
                    </StackPanel>
                </Button>
                <Button Classes="secondary" Content="{ui:Tr 'View in explorer'}" Command="{Binding OpenTxCommand}" CommandParameter="{Binding ReceiptItem}"
                        HorizontalAlignment="Stretch" IsVisible="{Binding ReceiptHasExplorer}" />
            </StackPanel>
        </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
